fn g6_test_routes_through_g2() {
    let intent = g6_make_intent("REST", 6, 0, nil, nil, nil)
    let via_g6 = g6_validate(intent)
    let via_g2 = g2_REST({
        scenario_id: "sc_rest",
        start_month: 0,
        duration_months: 6,
        created_at: g6_now_str()
    })
    if via_g6.kind != "Scenario" { return { ok: false, error: "g6 path failed" } }
    if via_g2.kind != "Scenario" { return { ok: false, error: "g2 path failed" } }
    if via_g6.type != via_g2.type { return { ok: false, error: "type mismatch" } }
    if via_g6.duration_months != via_g2.duration_months { return { ok: false, error: "duration mismatch" } }
    return { ok: true }
}

// =====================================================================
// End of G6
// =====================================================================

// =====================================================================
// G7 — Decision Memory (Final Patch, frozen)
// In-memory structured DecisionRecord store. Records go through
// G0's domain_DecisionRecord validation; no parallel invariant copy.
// Time-ordered; cap = 32 default; oldest evicted when exceeded. No raw
// chat text stored. HouseholdState remains the current state; decision
// memory only records what was decided and the snapshot at decision time.
// No parser / validation / simulation / policy / UI / persistence / flow.
// =====================================================================

let G7_DEFAULT_CAP = 32
let g7_decisions = []

fn g7_now_str() {
    let t = local_time()
    if t == nil || t == "" { return "2026-10-05T00:00:00Z" }
    return t
}

fn g7_generate_id() {
    let n = time_now()
    if n == nil { return "d_unknown_" + g7_decisions.len().to_string() }
    return "d_" + n.to_string() + "_" + g7_decisions.len().to_string()
}

fn g7_trim_to_cap(cap) {
    if g7_decisions.len() <= cap { return }
    let trimmed = []
    let start_idx = g7_decisions.len() - cap
    for i in g7_decisions.len() {
        if i >= start_idx { trimmed.push(g7_decisions[i]) }
    }
    g7_decisions = trimmed
}

fn g7_record(args) {
    let cap = args.cap
    if cap == nil { cap = G7_DEFAULT_CAP }

    let decision_id = args.decision_id
    if decision_id == nil || decision_id == "" { decision_id = g7_generate_id() }

    let created_at = args.created_at
    if created_at == nil || created_at == "" { created_at = g7_now_str() }

    let record_args = {
        decision_id: decision_id,
        scenario_id: args.scenario_id,
        created_at: created_at,
        user_choice: args.user_choice,
        reason: args.reason,
        snapshot: args.snapshot,
        policy_status: args.policy_status,
        review_at: args.review_at,
        legacy_migration: args.legacy_migration == true
    }
    let record = domain_DecisionRecord(record_args)
    if record.kind == "ValidationError" {
        return { ok: false, errors: record.errors }
    }
    g7_decisions.push(record)
    g7_trim_to_cap(cap)
    return { ok: true, record: record }
}

fn g7_recent(n) {
    if g7_decisions.len() == 0 { return [] }
    if n == nil { n = g7_decisions.len() }
    if n > g7_decisions.len() { n = g7_decisions.len() }
    let result = []
    let start_idx = g7_decisions.len() - n
    for i in g7_decisions.len() {
        if i >= start_idx { result.push(g7_decisions[i]) }
    }
    return result
}

fn g7_clear() {
    let empty = []
    g7_decisions = empty
}

fn g7_size() {
    return g7_decisions.len()
}

fn g7_set_all(records) {
    g7_decisions = []
    for i in records.len() {
        let validated = domain_DecisionRecord(records[i])
        if validated.kind == "DecisionRecord" { g7_decisions.push(validated) }
    }
}

fn g7_test_record_accept() {
    g7_clear()
    let r = g7_record({
        scenario_id: "sc1",
        user_choice: "accept",
        snapshot: { cash: 800000, buffer_months: 29.6 },
        policy_status: "ok"
    })
    if !r.ok { return { ok: false, error: "record failed", errors: r.errors } }
    if r.record.user_choice != "accept" { return { ok: false, error: "choice wrong" } }
    if g7_size() != 1 { return { ok: false, error: "size wrong" } }
    return { ok: true }
}

