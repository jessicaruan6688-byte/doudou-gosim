fn g3_test_trace_car_purchase_deducted_once() {
    let h = g3_demo_household()
    let s = g2_CAR_PURCHASE({
        scenario_id: "s",
        start_month: 12,
        purchase_amount: 300000,
        created_at: "t",
        description: nil
    })
    let r = g3_simulate(h, s)
    if r.kind != "SimulationResult" { return { success: false, error: "simulate failed" } }
    let total_one_time = 0
    let periods_with_one_time = 0
    for i in r.trace.len() {
        let ot = r.trace[i].scenario.one_time_expense
        total_one_time = total_one_time + ot
        if ot != 0 { periods_with_one_time = periods_with_one_time + 1 }
    }
    if total_one_time != 300000 { return { success: false, error: "purchase should be deducted exactly once", got: total_one_time } }
    if periods_with_one_time != 1 { return { success: false, error: "purchase should land in one period", got: periods_with_one_time } }
    if r.trace[13].scenario.one_time_expense != 300000 { return { success: false, error: "purchase should land on start_month", got: r.trace[13].scenario.one_time_expense } }
    return { success: true }
}

fn g3_test_trace_duration_zero_single_month() {
    let h = g3_demo_household()
    let s = g2_INCOME_CHANGE({
        scenario_id: "s",
        start_month: 12,
        monthly_income_delta: 5000,
        duration_months: 0,
        created_at: "t",
        description: nil
    })
    let r = g3_simulate(h, s)
    if r.kind != "SimulationResult" { return { success: false, error: "simulate failed" } }
    let affected = 0
    for i in r.trace.len() {
        if r.trace[i].scenario.income == 45000 { affected = affected + 1 }
    }
    if affected != 1 { return { success: false, error: "duration 0 should affect exactly one month", got: affected } }
    if r.delta.cash_delta != 5000 { return { success: false, error: "duration 0 income change adds one month of delta", got: r.delta.cash_delta } }
    return { success: true }
}

fn g3_test_trace_initial_point_and_length() {
    let h = g3_demo_household()
    let s = g2_REST({
        scenario_id: "s",
        start_month: 12,
        duration_months: 6,
        created_at: "t",
        description: nil
    })
    let r = g3_simulate(h, s)
    if r.kind != "SimulationResult" { return { success: false, error: "simulate failed" } }
    if r.trace.len() != r.horizon + 1 { return { success: false, error: "trace length should be horizon + 1", got: r.trace.len() } }
    if r.trace[0].period_index != 0 { return { success: false, error: "initial point index should be 0", got: r.trace[0].period_index } }
    if r.trace[0].baseline.ending_cash != 800000 { return { success: false, error: "initial point cash should be opening cash", got: r.trace[0].baseline.ending_cash } }
    if r.trace[0].scenario.ending_cash != 800000 { return { success: false, error: "initial point scenario cash should be opening cash", got: r.trace[0].scenario.ending_cash } }
    if r.trace[0].baseline.net_change != 0 { return { success: false, error: "initial point has no movement", got: r.trace[0].baseline.net_change } }
    if r.trace[r.horizon].period_index != r.horizon { return { success: false, error: "last period index should equal horizon", got: r.trace[r.horizon].period_index } }
    return { success: true }
}

fn g3_test_trace_ending_matches_summary() {
    let h = g3_demo_household()
    let s = g2_CAR_PURCHASE({
        scenario_id: "s",
        start_month: 6,
        purchase_amount: 300000,
        created_at: "t",
        description: nil
    })
    let r = g3_simulate(h, s)
    if r.kind != "SimulationResult" { return { success: false, error: "simulate failed" } }
    let last = r.trace[r.horizon]
    if last.baseline.ending_cash != r.baseline_path.cash_at_horizon { return { success: false, error: "baseline trace ending must match summary", got: last.baseline.ending_cash } }
    if last.scenario.ending_cash != r.scenario_path.cash_at_horizon { return { success: false, error: "scenario trace ending must match summary", got: last.scenario.ending_cash } }
    if last.baseline.buffer_months != r.baseline_path.buffer_at_horizon { return { success: false, error: "baseline buffer must match summary", got: last.baseline.buffer_months } }
    for i in r.trace.len() {
        if i > 0 {
            let p = r.trace[i].scenario
            if p.income - p.total_expense != p.net_change { return { success: false, error: "trace decomposition must reconcile", got: p.income - p.total_expense } }
            if p.opening_cash + p.net_change != p.ending_cash { return { success: false, error: "trace must roll forward by net_change", got: p.ending_cash } }
        }
    }
    return { success: true }
}

fn g3_test_g4_keeps_top_level_trace() {
    let h = g3_demo_household()
    let s = g2_REST({
        scenario_id: "s",
        start_month: 0,
        duration_months: 18,
        created_at: "t",
        description: nil
    })
    let r = g3_simulate(h, s)
    if r.kind != "SimulationResult" { return { success: false, error: "simulate failed" } }
    let policy = g4_demo_policy(12, 0, 12)
    let tagged = g4_policy_evaluate(r, policy)
    if tagged.kind != "SimulationResult" { return { success: false, error: "policy_evaluate failed" } }
    if tagged.trace == nil { return { success: false, error: "G4 dropped the top level trace" } }
    if tagged.trace.len() != r.trace.len() { return { success: false, error: "G4 changed the trace length", got: tagged.trace.len() } }
    if tagged.trace[1].scenario.net_change != 0 - 27000 { return { success: false, error: "G4 trace content changed", got: tagged.trace[1].scenario.net_change } }
    if tagged.scenario_path.policy_status != "danger" { return { success: false, error: "policy classification changed", got: tagged.scenario_path.policy_status } }
    return { success: true }
}

fn g3_test_trace_breach_behavior_unchanged() {
    let h = g3_demo_household()
    let s = g2_REST({
        scenario_id: "s",
        start_month: 0,
        duration_months: 18,
        created_at: "t",
        description: nil
    })
    let r = g3_simulate(h, s)
    if r.kind != "SimulationResult" { return { success: false, error: "simulate failed" } }
    if r.scenario_path.breach_month == nil { return { success: false, error: "rest 18M should breach" } }
    let b = r.scenario_path.breach_month
    if r.trace[b].scenario.buffer_months >= 12 { return { success: false, error: "breach month buffer should be below floor", got: r.trace[b].scenario.buffer_months } }
    if b > 0 {
        if r.trace[b - 1].scenario.buffer_months < 12 { return { success: false, error: "breach should be the first month below floor", got: r.trace[b - 1].scenario.buffer_months } }
    }
    if r.baseline_path.breach_month != nil { return { success: false, error: "baseline should never breach", got: r.baseline_path.breach_month } }
    return { success: true }
}

// =====================================================================
// End of G3
// =====================================================================

// =====================================================================
// G4 — Policy (Final Patch, frozen)
// Pure policy_evaluate(simulation_result, policy). Tags baseline_path
// and scenario_path with policy_status. Returns a NEW tagged result;
// never mutates the input. No simulation, no parser, no validation,
// no UI, no persistence. Thresholds strictly from SafetyPolicy.
// =====================================================================

fn g4_classify_path(path, policy) {
    let status = "ok"
    if path.breach_month != nil { status = "danger" }
    if path.cash_at_horizon < policy.minimum_cash_after_event { status = "danger" }
    if status != "danger" {
        if path.buffer_at_horizon < policy.warn_buffer_threshold {
            status = "warn"
        }
    }
    return status
}

fn g4_tagged_path(path, status) {
    return {
        cash_at_horizon: path.cash_at_horizon,
        buffer_at_horizon: path.buffer_at_horizon,
        minimum_cash: path.minimum_cash,
        minimum_buffer: path.minimum_buffer,
        breach_month: path.breach_month,
        policy_status: status
    }
}

fn g4_policy_evaluate(simulation_result, policy) {
    if simulation_result == nil || simulation_result.kind != "SimulationResult" {
        return simulation_result
    }
    if policy == nil || policy.kind != "SafetyPolicy" {
        return simulation_result
    }
    let baseline_status = g4_classify_path(simulation_result.baseline_path, policy)
    let scenario_status = g4_classify_path(simulation_result.scenario_path, policy)
    return {
        kind: "SimulationResult",
        scenario_id: simulation_result.scenario_id,
        horizon: simulation_result.horizon,
        baseline_path: g4_tagged_path(simulation_result.baseline_path, baseline_status),
        scenario_path: g4_tagged_path(simulation_result.scenario_path, scenario_status),
        delta: simulation_result.delta,
        trace: simulation_result.trace
    }
}

fn g4_demo_policy(min_buf, min_cash, warn_buf) {
    let args = {
        minimum_buffer_months: min_buf,
        minimum_cash_after_event: min_cash,
        warn_buffer_threshold: warn_buf
    }
    return domain_SafetyPolicy(args)
}

fn g4_demo_result(breach_month, cash, buffer) {
    return {
        kind: "SimulationResult",
        scenario_id: "sr_test",
        horizon: 18,
        baseline_path: {
            cash_at_horizon: cash,
            buffer_at_horizon: buffer,
            minimum_cash: cash,
            minimum_buffer: buffer,
            breach_month: breach_month,
            policy_status: "pending"
        },
        scenario_path: {
            cash_at_horizon: cash,
            buffer_at_horizon: buffer,
            minimum_cash: cash,
            minimum_buffer: buffer,
            breach_month: breach_month,
            policy_status: "pending"
        },
        delta: {
            cash_delta: 0,
            buffer_delta: 0,
            minimum_cash_delta: 0,
            minimum_buffer_delta: 0
        },
        trace: []
    }
}

fn g4_test_danger_breach() {
    let policy = g4_demo_policy(12, 0, 20)
    let r = g4_demo_result(5, 800000, 29.6)
    let tagged = g4_policy_evaluate(r, policy)
    if tagged.baseline_path.policy_status != "danger" {
        return { success: false, error: "should be danger due to breach", got: tagged.baseline_path.policy_status }
    }
    if tagged.scenario_path.policy_status != "danger" {
        return { success: false, error: "scenario should also be danger", got: tagged.scenario_path.policy_status }
    }
    return { success: true }
}

