// =====================================================================
// G0 — Domain Model (Final Patch, frozen)
// Type definitions + invariant checks. No I/O. No behavior beyond
// type construction and validation. Defined here but not yet wired
// into the existing v0.1 path.
// =====================================================================

let _G0_SCENARIO_TYPES = ["REST", "CAR_PURCHASE", "INCOME_CHANGE", "EXPENSE_CHANGE"]
let _G0_DECISION_CHOICES = ["accept", "decline", "defer"]
let _G0_AGENT_STATES = [
    "IDLE", "UNDERSTANDING", "NEED_CLARIFICATION", "SCENARIO_READY",
    "SIMULATING", "RESULT_READY", "USER_REVIEW", "DECISION_RECORDED",
    "PARSE_FAILED", "VALIDATION_FAILED", "SIMULATION_FAILED", "AGENT_UNAVAILABLE"
]

fn _G0_contains(arr, val) {
    for i in arr.len() {
        if arr[i] == val { return true }
    }
    return false
}

fn _G0_err(errors, msg) {
    errors.push(msg)
}

// ----- HouseholdState -----
fn domain_HouseholdState(args) {
    let errs = []
    if args.schema_version != 2 { _G0_err(errs, "schema_version must be 2") }
    if args.household_id == nil || args.household_id == "" { _G0_err(errs, "household_id required") }
    if args.created_at == nil || args.created_at == "" { _G0_err(errs, "created_at required") }
    if args.updated_at == nil || args.updated_at == "" { _G0_err(errs, "updated_at required") }
    if args.monthly_income == nil || args.monthly_income < 0 { _G0_err(errs, "monthly_income must be >= 0") }
    if args.mortgage == nil || args.mortgage < 0 { _G0_err(errs, "mortgage must be >= 0") }
    if args.living == nil || args.living <= 0 { _G0_err(errs, "living must be > 0") }
    if args.liquid_cash == nil || args.liquid_cash < 0 { _G0_err(errs, "liquid_cash must be >= 0") }
    if args.safety_floor_months == nil || args.safety_floor_months <= 0 { _G0_err(errs, "safety_floor_months must be > 0") }
    if errs.len() > 0 {
        return { kind: "ValidationError", errors: errs }
    }
    return {
        kind: "HouseholdState",
        schema_version: 2,
        household_id: args.household_id,
        created_at: args.created_at,
        updated_at: args.updated_at,
        monthly_income: args.monthly_income,
        mortgage: args.mortgage,
        living: args.living,
        liquid_cash: args.liquid_cash,
        safety_floor_months: args.safety_floor_months
    }
}

fn domain_is_household_state(x) {
    return x != nil && x.kind == "HouseholdState"
}

// ----- SafetyPolicy -----
fn domain_SafetyPolicy(args) {
    let errs = []
    if args.minimum_buffer_months == nil || args.minimum_buffer_months <= 0 { _G0_err(errs, "minimum_buffer_months must be > 0") }
    if args.minimum_cash_after_event == nil || args.minimum_cash_after_event < 0 { _G0_err(errs, "minimum_cash_after_event must be >= 0") }
    let warn = args.warn_buffer_threshold
    if warn == nil { warn = args.minimum_buffer_months }
    if warn < args.minimum_buffer_months { _G0_err(errs, "warn_buffer_threshold must be >= minimum_buffer_months") }
    if errs.len() > 0 {
        return { kind: "ValidationError", errors: errs }
    }
    return {
        kind: "SafetyPolicy",
        minimum_buffer_months: args.minimum_buffer_months,
        minimum_cash_after_event: args.minimum_cash_after_event,
        warn_buffer_threshold: warn
    }
}

fn domain_is_safety_policy(x) {
    return x != nil && x.kind == "SafetyPolicy"
}

// ----- Scenario -----
fn domain_Scenario(args) {
    let errs = []
    if args.scenario_id == nil || args.scenario_id == "" { _G0_err(errs, "scenario_id required") }
    if args.type == nil || !_G0_contains(_G0_SCENARIO_TYPES, args.type) { _G0_err(errs, "type must be one of REST, CAR_PURCHASE, INCOME_CHANGE, EXPENSE_CHANGE") }
    if args.start_month == nil || args.start_month < 0 { _G0_err(errs, "start_month must be >= 0") }
    if args.duration_months == nil || args.duration_months < 0 { _G0_err(errs, "duration_months must be >= 0") }
    if args.created_at == nil || args.created_at == "" { _G0_err(errs, "created_at required") }
    if args.type == "REST" {
        if args.duration_months == 0 { _G0_err(errs, "REST duration_months must be > 0") }
    }
    if args.type == "CAR_PURCHASE" {
        if args.purchase_amount == nil { _G0_err(errs, "CAR_PURCHASE requires purchase_amount") }
        if args.purchase_amount != nil && args.purchase_amount < 0 { _G0_err(errs, "CAR_PURCHASE purchase_amount must be >= 0") }
    }
    if args.type == "INCOME_CHANGE" {
        if args.monthly_income_delta == nil { _G0_err(errs, "INCOME_CHANGE requires monthly_income_delta") }
        if args.monthly_expense_delta != nil { _G0_err(errs, "INCOME_CHANGE must not have monthly_expense_delta") }
    }
    if args.type == "EXPENSE_CHANGE" {
        if args.monthly_expense_delta == nil { _G0_err(errs, "EXPENSE_CHANGE requires monthly_expense_delta") }
        if args.monthly_income_delta != nil { _G0_err(errs, "EXPENSE_CHANGE must not have monthly_income_delta") }
    }
    if errs.len() > 0 {
        return { kind: "ValidationError", errors: errs }
    }
    return {
        kind: "Scenario",
        scenario_id: args.scenario_id,
        type: args.type,
        start_month: args.start_month,
        duration_months: args.duration_months,
        created_at: args.created_at,
        description: args.description,
        purchase_amount: args.purchase_amount,
        monthly_income_delta: args.monthly_income_delta,
        monthly_expense_delta: args.monthly_expense_delta
    }
}

fn domain_is_scenario(x) {
    return x != nil && x.kind == "Scenario"
}

// ----- ParsedIntent -----
fn domain_ParsedIntent(args) {
    let ambiguous = args.ambiguous_fields
    if ambiguous == nil { ambiguous = [] }
    return {
        kind: "ParsedIntent",
        intent_type: args.intent_type,
        start_month: args.start_month,
        duration_months: args.duration_months,
        purchase_amount: args.purchase_amount,
        monthly_income_delta: args.monthly_income_delta,
        monthly_expense_delta: args.monthly_expense_delta,
        ambiguous_fields: ambiguous
    }
}

fn domain_is_parsed_intent(x) {
    return x != nil && x.kind == "ParsedIntent"
}

// ----- SimulationResult -----
fn domain_SimulationResult(args) {
    return {
        kind: "SimulationResult",
        scenario_id: args.scenario_id,
        horizon: args.horizon,
        baseline_path: args.baseline_path,
        scenario_path: args.scenario_path,
        delta: args.delta,
        trace: args.trace
    }
}

fn domain_is_simulation_result(x) {
    return x != nil && x.kind == "SimulationResult"
}

// ----- DecisionRecord -----
fn domain_DecisionRecord(args) {
    let errs = []
    if args.decision_id == nil || args.decision_id == "" { _G0_err(errs, "decision_id required") }
    if args.scenario_id == nil || args.scenario_id == "" { _G0_err(errs, "scenario_id required") }
    if args.created_at == nil || args.created_at == "" { _G0_err(errs, "created_at required") }
    if args.user_choice == nil || !_G0_contains(_G0_DECISION_CHOICES, args.user_choice) { _G0_err(errs, "user_choice must be accept, decline, or defer") }
    if args.snapshot == nil { _G0_err(errs, "snapshot required") }
    if args.policy_status == nil { _G0_err(errs, "policy_status required") }
    if errs.len() > 0 {
        return { kind: "ValidationError", errors: errs }
    }
    return {
        kind: "DecisionRecord",
        decision_id: args.decision_id,
        scenario_id: args.scenario_id,
        created_at: args.created_at,
        user_choice: args.user_choice,
        reason: args.reason,
        snapshot: args.snapshot,
        policy_status: args.policy_status,
        review_at: args.review_at,
        legacy_migration: args.legacy_migration == true
    }
}

fn domain_is_decision_record(x) {
    return x != nil && x.kind == "DecisionRecord"
}

// ----- AgentState -----
fn domain_AgentState(args) {
    let errs = []
    if args.state == nil || !_G0_contains(_G0_AGENT_STATES, args.state) { _G0_err(errs, "state must be a valid AgentState") }
    if args.last_transition_at == nil || args.last_transition_at == "" { _G0_err(errs, "last_transition_at required") }
    if errs.len() > 0 {
        return { kind: "ValidationError", errors: errs }
    }
    return {
        kind: "AgentState",
        state: args.state,
        last_transition_at: args.last_transition_at,
        last_error: args.last_error
    }
}

fn domain_is_agent_state(x) {
    return x != nil && x.kind == "AgentState"
}

// ----- Failure types -----
fn domain_ValidationFailure(errors) {
    return { kind: "ValidationFailure", errors: errors }
}

fn domain_is_validation_failure(x) {
    return x != nil && x.kind == "ValidationFailure"
}

fn domain_ClarificationRequest(args) {
    let missing = args.missing_fields
    if missing == nil { missing = [] }
    // field_errors is optional and no call site passes it; a missing key
    // traps on plain access in Splash (missing fields are errors, not nil),
    // so guard the read with try and keep the original nil -> [] default.
    let field_errors = try { args.field_errors } { nil }
    if field_errors == nil { field_errors = [] }
    return {
        kind: "ClarificationRequest",
        missing_fields: missing,
        question: args.question,
        field_errors: field_errors
    }
}

fn domain_is_clarification_request(x) {
    return x != nil && x.kind == "ClarificationRequest"
}

fn domain_ParseFailure(reason) {
    return { kind: "ParseFailure", reason: reason }
}

fn domain_is_parse_failure(x) {
    return x != nil && x.kind == "ParseFailure"
}

// =====================================================================
// End of G0
