fn g8_test_persistence_roundtrip() {
    g8_init()
    let h = g3_demo_household()
    let save_result = persist_save_household(h)
    if !save_result.success { return { success: false, error: "save failed" } }
    let loaded = persist_load_household()
    if loaded.kind != "HouseholdState" { return { success: false, error: "load failed" } }
    if loaded.monthly_income != h.monthly_income { return { success: false, error: "roundtrip mismatch" } }
    return { success: true }
}

fn g8_test_migration() {
    let v01 = {
        income: 40000, mortgage: 15000, savings: 800000, living: 12000,
        safety: 12, single_income: true,
        car_wan: 0, car_on: false, car_held: false, fear: "",
        sim: "now", rest_months: 6,
        trail: [], prompt: "test"
    }
    fs.write("state.json", v01.to_json())
    let mig = persist_migrate_v01_to_v02()
    if !mig.success { return { success: false, error: "migration failed" } }
    if mig.state.monthly_income != 40000 { return { success: false, error: "income mapping wrong" } }
    if mig.state.liquid_cash != 800000 { return { success: false, error: "liquid_cash mapping wrong" } }
    return { success: true }
}

fn g8_test_full_chain_smoke() {
    g8_init()
    let h = g3_demo_household()
    let state = g8_clone_state(g8_view_state)
    state.household = h
    g8_view_state = state
    let initial_decisions = g7_size()
    let s1 = flow_submit_text("想辞职半年")
    if s1.screen != G8_RESULT { return { success: false, error: "G5→G6→G3→G4→view_state failed", got_screen: s1.screen } }
    if s1.simulation_result == nil { return { success: false, error: "no simulation_result" } }
    if s1.policy_status_scenario == nil { return { success: false, error: "no policy_status_scenario" } }
    let s2 = flow_decide("accept")
    if s2.screen != G8_DECISION_RECORDED { return { success: false, error: "decision flow failed" } }
    if g7_size() != initial_decisions + 1 { return { success: false, error: "G7 record count wrong" } }
    return { success: true }
}

fn g8_test_decision_persistence_roundtrip() {
    g8_init()
    let h = g3_demo_household()
    let state = g8_clone_state(g8_view_state)
    state.household = h
    g8_view_state = state
    g7_clear()

    flow_submit_text("想辞职半年")
    flow_decide("accept")

    let after_record = g7_size()

    g7_clear()
    if g7_size() != 0 { return { success: false, error: "in-memory not cleared" } }

    let loaded = persist_load_decisions()
    if loaded.kind != "Records" { return { success: false, error: "no records loaded" } }
    g7_set_all(loaded.records)

    if g7_size() != after_record { return { success: false, error: "restored count mismatch" } }
    return { success: true }
}

fn g8_test_three_choices_persistence() {
    g8_init()
    let h = g3_demo_household()
    let state = g8_clone_state(g8_view_state)
    state.household = h
    g8_view_state = state
    g7_clear()

    flow_submit_text("想辞职半年")
    flow_decide("accept")
    flow_submit_text("买辆 30 万的车")
    flow_decide("decline")
    flow_submit_text("想辞职 18 个月")
    flow_decide("defer")

    let count = g7_size()

    g7_clear()
    let loaded = persist_load_decisions()
    if loaded.kind != "Records" { return { success: false, error: "load failed" } }
    g7_set_all(loaded.records)

    if g7_size() != count { return { success: false, error: "count mismatch" } }

    let recent = g7_recent(3)
    if recent[0].user_choice != "accept" { return { success: false, error: "first should be accept" } }
    if recent[1].user_choice != "decline" { return { success: false, error: "second should be decline" } }
    if recent[2].user_choice != "defer" { return { success: false, error: "third should be defer" } }
    return { success: true }
}

fn g8_test_decision_snapshot_uses_current_state() {
    g8_init()
    let h = g3_demo_household()
    let state = g8_clone_state(g8_view_state)
    state.household = h
    g8_view_state = state
    g7_clear()

    let s = flow_submit_text("想辞职半年")
    if s.screen != G8_RESULT { return { success: false, error: "expected RESULT" } }

    flow_decide("accept")

    let last = g7_recent(1)
    if last.len() != 1 { return { success: false, error: "no decision" } }
    if last[0].snapshot.cash != 800000 {
        return { success: false, error: "snapshot.cash should be 800000 (current), got " + last[0].snapshot.cash.to_string() }
    }
    if last[0].snapshot.buffer_months < 29.0 || last[0].snapshot.buffer_months > 30.0 {
        return { success: false, error: "snapshot.buffer_months should be ~29.6 (current), got " + last[0].snapshot.buffer_months.to_string() }
    }
    return { success: true }
}

fn g8_test_decision_persistence_does_not_mutate_household() {
    g8_init()
    let h = g3_demo_household()
    let cash_before = h.liquid_cash
    let state = g8_clone_state(g8_view_state)
    state.household = h
    g8_view_state = state
    g7_clear()

    flow_submit_text("想辞职半年")
    flow_decide("accept")

    if h.liquid_cash != cash_before {
        return { success: false, error: "household mutated by decision persistence" }
    }
    if state.household.liquid_cash != cash_before {
        return { success: false, error: "state.household mutated" }
    }
    return { success: true }
}

fn g8_test_render_no_legacy_globals() {
    g8_init()
    let h = g3_demo_household()
    let state = g8_clone_state(g8_view_state)
    state.household = h
    state.screen = G8_RESULT
    g8_view_state = state

    let r1 = g8_render_text()
    if r1 == nil { return { success: false, error: "render returned nil" } }

    state.screen = G8_IDLE
    g8_view_state = state
    let r2 = g8_render_text()
    if r2 == nil { return { success: false, error: "render returned nil on IDLE" } }

    state.screen = G8_NEED_CLARIFICATION
    state.clarification = { missing_fields: ["duration_months"], question: "几个月？" }
    g8_view_state = state
    let r3 = g8_render_text()
    if r3 == nil { return { success: false, error: "render returned nil on CLARIFICATION" } }

    return { success: true }
}

fn g8_test_decision_persistence_does_not_overwrite_household() {
    g8_init()
    let h = g3_demo_household()
    let state = g8_clone_state(g8_view_state)
    state.household = h
    g8_view_state = state
    g7_clear()

    flow_submit_text("想辞职半年")
    flow_decide("accept")

    let h_reloaded = persist_load_household()
    if h_reloaded.kind != "HouseholdState" { return { success: false, error: "household not found after decision" } }
    if h_reloaded.liquid_cash != h.liquid_cash { return { success: false, error: "household mutated by decision persistence" } }
    if h_reloaded.monthly_income != h.monthly_income { return { success: false, error: "household income mutated" } }
    return { success: true }
}

// (Acceptance test runner removed due to OctoScript parser limitations —
// see Final Acceptance report. All 84 G0–G8 fixtures remain callable.)

// =====================================================================
// End of G8
// =====================================================================

let income = nil
let mortgage = nil
let savings = nil
let living = nil
let living_assumed = false
let safety = nil
let single_income = false
let car_wan = nil
let car_on = false
let car_held = false
let fear = ""
let sim = "now"
let rest_months = 6
let trail = []
let prompt = "说一句你的情况，不用填表。"

fn num_or_nil(v) {
    if v == nil { return nil }
    if v >= 0 { return v }
    return nil
}

fn load() {
    if fs.exists("state.json") {
        let v = fs.read("state.json").parse_json()
        if v != nil {
            income = num_or_nil(v.income)
            mortgage = num_or_nil(v.mortgage)
            savings = num_or_nil(v.savings)
            living = num_or_nil(v.living)
            living_assumed = v.living_assumed == true
            safety = num_or_nil(v.safety)
            single_income = v.single_income == true
            car_wan = num_or_nil(v.car_wan)
            car_on = v.car_on == true
            car_held = v.car_held == true
            if v.fear != nil { fear = v.fear }
            if v.sim != nil { sim = v.sim }
            rest_months = num_or_nil(v.rest_months)
            if rest_months == nil { rest_months = 6 }
            if v.trail != nil { trail = v.trail }
            if v.prompt != nil { prompt = v.prompt }
        }
    }
    ui.board.render()
}

fn save() {
    fs.write("state.json", {
        income: income
        mortgage: mortgage
        savings: savings
        living: living
        living_assumed: living_assumed
        safety: safety
        single_income: single_income
        car_wan: car_wan
        car_on: car_on
        car_held: car_held
        fear: fear
        sim: sim
        rest_months: rest_months
        trail: trail
        prompt: prompt
    }.to_json())
}

fn fmt_num(n) {
    if n == nil { return "-" }
    // The loop below counts one integer at a time. A number in the hundreds of
    // thousands (a cash amount in yuan) would spend the whole instruction
    // budget here, so large values are answered directly. Everything below the
    // threshold keeps the original path unchanged.
    if n >= 100000.0 { return "" + floor(n + 0.0001) }
    let whole = 0
    let limit = n + 0.0001
    while whole + 1 <= limit { whole = whole + 1 }
    let diff = n - whole
    if diff < 0 { diff = 0 - diff }
    if diff < 0.05 { return "" + whole }
    let ft = (n - whole) * 10.0 + 0.5
    let fw = 0
    let fl = ft
    while fw + 1 <= fl { fw = fw + 1 }
    if fw >= 10 { return "" + (whole + 1) }
    return "" + whole + "." + fw
}

fn wan_text(yuan) {
    if yuan == nil { return "-" }
    return fmt_num(yuan / 10000.0) + " 万"
}

// Cheap integer formatter for yuan amounts. fmt_num counts integers one at a
// time below 100000, which burns the render instruction budget when a page
// shows several raw yuan values (8000 + 19000 + 40000 ...). Yuan amounts in
// this app are whole numbers, so floor is exact; month buffers keep fmt_num.
fn fmt_yuan(n) {
    if n == nil { return "-" }
    return "" + floor(n + 0.0001)
}

// fmt_num mishandles negatives (its counting loop never runs below 0), so
// signed month counts split the sign out and format the magnitude only.
fn fmt_months(n) {
    if n == nil { return "-" }
    if n < 0 { return "-" + fmt_num(0 - n) }
    return fmt_num(n)
}

// wan_text inherits the broken negative handling of fmt_num, so signed
// cash amounts split the sign out first (same trick as fmt_months).
fn fmt_wan(n) {
    if n == nil { return "-" }
    if n < 0 { return "-" + wan_text(0 - n) }
    return wan_text(n)
}

fn g8_scenario_label(summary) {
    if summary == nil { return "当前情景" }
    if summary.type == "REST" { return "休息 " + fmt_num(summary.duration_months) + " 个月" }
    if summary.type == "CAR_PURCHASE" { return "买车 " + wan_text(summary.purchase_amount) }
    if summary.type == "INCOME_CHANGE" { return "收入变化 " + wan_text(summary.monthly_income_delta) + " /月" }
    if summary.type == "EXPENSE_CHANGE" { return "支出变化 " + wan_text(summary.monthly_expense_delta) + " /月" }
    return summary.type
}

fn g8_scenario_id_label(id) {
    if id == "sc_rest" { return "一次休息" }
    if id == "sc_car" { return "一次买车" }
    if id == "sc_inc" { return "一次收入变化" }
    if id == "sc_exp" { return "一次支出变化" }
    return id
}

let G8_C_BASE = #xb8bec6

fn g8poz(x) {
    if x < 0 { return 0 }
    return x
}

fn g8_chart_scale(tr, floor_cash) {
    let max_v = floor_cash
    let min_v = floor_cash
    for i in tr.len() {
        let rv = tr[i]
        if rv.baseline.ending_cash > max_v { max_v = rv.baseline.ending_cash }
        if rv.scenario.ending_cash > max_v { max_v = rv.scenario.ending_cash }
        if rv.baseline.ending_cash < min_v { min_v = rv.baseline.ending_cash }
        if rv.scenario.ending_cash < min_v { min_v = rv.scenario.ending_cash }
    }
    let pad_v = (max_v - min_v) * 0.08
    if pad_v < 1000 { pad_v = 1000 }
    max_v = max_v + pad_v
    min_v = min_v - pad_v
    let range_v = max_v - min_v
    if range_v < 1 { range_v = 1 }
    let unit = 130.0 / range_v
    let ha = (max_v - floor_cash) * unit
    let hb = (floor_cash - min_v) * unit
    if ha < 0 { ha = 0 }
    if hb < 0 { hb = 0 }
    return { unit: unit, h_above: ha, h_below: hb, min_v: min_v, max_v: max_v }
}

// Cash plot model: faithful Splash adaptation of the architect's
// buildCashPlotModel reference. Sole source: G3 sr.trace scenario track.
// Domain always includes 0 (negative cash is never clipped to zero).
fn g8_cash_plot_model(tr, floor_cash, width, height, sel, engine_breach) {
    let max_v = floor_cash
    let min_v = 0
    for i in tr.len() {
        let c = tr[i].scenario.ending_cash
        if c > max_v { max_v = c }
        if c < min_v { min_v = c }
    }
    let pad_v = (max_v - min_v) * 0.08
    if pad_v < 1000 { pad_v = 1000 }
    max_v = max_v + pad_v
    min_v = min_v - pad_v
    let range_v = max_v - min_v
    if range_v < 1 { range_v = 1 }
    let unit = height / range_v
    let ha = (max_v - floor_cash) * unit
    let hb = (floor_cash - min_v) * unit
    if ha < 0 { ha = 0 }
    if hb < 0 { hb = 0 }
    let min_i = 0
    let min_cash = tr[0].scenario.ending_cash
    let ot_i = 0 - 1
    let any_below = 0
    for i in tr.len() {
        let c = tr[i].scenario.ending_cash
        if c < min_cash { min_cash = c min_i = i }
        if tr[i].scenario.one_time_expense > 0 && ot_i < 0 { ot_i = i }
        if c < floor_cash { any_below = any_below + 1 }
    }
    // Diagnostic only: engine breach must agree with the trace.
    let conflict = 0
    if engine_breach != nil && any_below == 0 { conflict = 1 }
    return { unit: unit, h_above: ha, h_below: hb, min_v: min_v, max_v: max_v,
        min_i: min_i, min_cash: min_cash, ot_i: ot_i, sel: sel, conflict: conflict }
}

fn g8_min_cash_month(tr) {
    let mi = 0
    let mc = tr[0].scenario.ending_cash
    for i in tr.len() {
        if tr[i].scenario.ending_cash < mc { mc = tr[i].scenario.ending_cash mi = i }
    }
    return { idx: mi, cash: mc }
}

fn g8_one_time_month(tr) {
    for i in tr.len() {
        if tr[i].scenario.one_time_expense != 0 { return i }
    }
    return 0 - 1
}

fn g8_clamp_month(state) {
    let smi = 1
    if state.selected_month != nil && state.selected_month > 1 { smi = state.selected_month }
    if state.simulation_result != nil {
        let t9 = try { state.simulation_result.trace } { nil }
        if t9 != nil && t9.len() > 1 && smi > t9.len() - 1 { smi = t9.len() - 1 }
    }
    return smi
}

fn g8_on_click_month_step(delta) {
    let state = g8_clone_state(g8_view_state)
    let smi = g8_clamp_month(state)
    smi = smi + delta
    if smi < 1 { smi = 1 }
    state.selected_month = smi
    state.screen = G8_FLOW
    g8_view_state = state
    ui.board.render()
}

fn wan_near(text, label) {
    let found = regex(label + "\\s*(\\d+(?:\\.\\d+)?)\\s*万", "").exec(text)
    if found == nil { return nil }
    let n = found.captures[1].to_f64()
    if n >= 0 { return n * 10000.0 }
    return nil
}

fn months_near(text) {
    let found = regex("(\\d+)\\s*个?\\s*月", "").exec(text)
    if found == nil { return nil }
    return found.captures[1].to_f64()
}

fn necessary() {
    if mortgage == nil || living == nil { return nil }
    return mortgage + living
}

fn cash_now() {
    if savings == nil { return nil }
    let cash = savings
    if sim == "car" && car_wan != nil { cash = savings - car_wan }
    if sim == "rest" {
        let spend = necessary()
        if spend != nil { cash = cash - spend * rest_months }
        if cash < 0 { cash = 0 }
    }
    return cash
}

fn buffer_months() {
    let cash = cash_now()
    let spend = necessary()
    if cash == nil || spend == nil || spend == 0 { return nil }
    return cash / spend
}

fn base_months() {
    if savings == nil { return nil }
    let spend = necessary()
    if spend == nil || spend == 0 { return nil }
    return savings / spend
}

fn margin_months() {
    let buf = buffer_months()
    if buf == nil || safety == nil { return nil }
    return buf - safety
}

fn needed_for_safety() {
    let spend = necessary()
    if spend == nil || safety == nil { return nil }
    return spend * safety
}

fn watch_level() {
    let buf = buffer_months()
    let marg = margin_months()
    if buf == nil || safety == nil { return "none" }
    if buf < safety { return "danger" }
    if marg != nil && marg < 6.0 { return "warn" }
    return "ok"
}

fn ready() {
    return income != nil && mortgage != nil && savings != nil && living != nil && safety != nil
}

fn remember(line) {
    trail.push(line)
    if trail.len() > 8 {
        let kept = []
        for i in trail.len() {
            if i >= trail.len() - 8 { kept.push(trail[i]) }
        }
        trail = kept
    }
}

fn missing_line() {
    let gap = ""
    if income == nil { gap = gap + "月收入、" }
    if mortgage == nil { gap = gap + "房贷、" }
    if savings == nil { gap = gap + "存款、" }
    if safety == nil { gap = gap + "希望至少撑几个月、" }
    if gap == "" { return "" }
    return "我还缺：" + gap + "说一下就行。"
}

fn hear_profile(text) {
    let next_income = wan_near(text, "月薪")
    if next_income == nil { next_income = wan_near(text, "月收入") }
    let next_mortgage = wan_near(text, "房贷")
    let next_savings = wan_near(text, "存款")
    let next_safety = months_near(text)
    if next_income == nil && next_mortgage == nil && next_savings == nil && next_safety == nil {
        prompt = "我还没听到月收入、房贷或存款。比如：月薪 4 万，房贷 1.5 万，存款 80 万。"
        save()
        ui.board.render()
        return
    }
    if income != nil && next_income != nil && next_income != income {
        prompt = "月收入和已经记下的 " + wan_text(income) + " 对不上。我先不改。"
        save()
        ui.board.render()
        return
    }
    if mortgage != nil && next_mortgage != nil && next_mortgage != mortgage {
        prompt = "房贷和已经记下的 " + wan_text(mortgage) + " 对不上。我先不改。"
        save()
        ui.board.render()
        return
    }
    if savings != nil && next_savings != nil && next_savings != savings {
        prompt = "存款和已经记下的 " + wan_text(savings) + " 对不上。我先不改。"
        save()
        ui.board.render()
        return
    }
    if next_income != nil { income = next_income }
    if next_mortgage != nil { mortgage = next_mortgage }
    if next_savings != nil { savings = next_savings }
    if next_safety != nil { safety = next_safety }
    if text.search("老婆") >= 0 || text.search("配偶") >= 0 || text.search("家里") >= 0 { single_income = true }
    if text.search("工作") >= 0 && (text.search("老婆") >= 0 || text.search("配偶") >= 0) {
        single_income = false
        remember("家里有了第二份收入")
        prompt = "你之前最担心只剩一份收入。现在这个风险下降了。"
        save()
        ui.board.render()
        return
    }
    if text.search("失业") >= 0 || text.search("辞职") >= 0 { fear = "失业" }
    if living == nil && mortgage != nil {
        living = 12000
        living_assumed = true
    }
    let gap = missing_line()
    if gap != "" { prompt = gap }
    else {
        let buf = buffer_months()
        prompt = "记下了。你现在拿得出的钱，还能撑 " + fmt_num(buf) + " 个月。"
    }
    save()
    ui.board.render()
}

fn hear_car(text) {
    if !ready() {
        prompt = missing_line()
        if prompt == "" { prompt = "买车之前，我要先知道存款、房贷和你希望至少撑几个月。" }
        save()
        ui.board.render()
        return
    }
    let found = regex("(\\d+(?:\\.\\d+)?)\\s*万", "").exec(text)
    if found == nil {
        prompt = "这辆车大概多少万？说个数就行。"
        save()
        ui.board.render()
        return
    }
    let wan = found.captures[1].to_f64() * 10000.0
    if wan > savings {
        prompt = "这笔 " + fmt_num(wan / 10000.0) + " 万比现在的存款还多。我先不改。"
        save()
        ui.board.render()
        return
    }
    car_wan = wan
    car_on = true
    car_held = false
    sim = "car"
    let before = base_months()
    let after = buffer_months()
    let marg = after - safety
    if fear != "" { prompt = "你说过最担心" + fear + "。" } else { prompt = "" }
    if marg > 0 {
        prompt = prompt + "这辆车买得起，缓冲从 " + fmt_num(before) + " 个月变成 " + fmt_num(after) + " 个月。"
    } else {
        prompt = prompt + "这辆车买完，缓冲会掉到 " + fmt_num(after) + " 个月，低于你的 " + fmt_num(safety) + " 个月底线。"
    }
    save()
    ui.board.render()
}

fn hear() {
    let text = ui.entry.text().trim()
    if text == "" { return }
    ui.entry.set_text("")
    if text.search("辞职") >= 0 || text.search("休息") >= 0 || text.search("不干了") >= 0 {
        fear = "失业"
        let n = months_near(text)
        if n == nil { n = 6 }
        sim = "rest"
        rest_months = n
        let buf = buffer_months()
        prompt = "休息 " + fmt_num(n) + " 个月，缓冲剩 " + fmt_num(buf) + " 个月。"
        save()
        ui.board.render()
        return
    }
    if text.search("车") >= 0 { hear_car(text) }
    else { hear_profile(text) }
}

fn set_now() {
    sim = "now"
    car_on = false
    let buf = base_months()
    prompt = "回到现在。缓冲是 " + fmt_num(buf) + " 个月。"
    save()
    ui.board.render()
}

fn set_car() {
    if car_wan == nil { car_wan = 300000 }
    sim = "car"
    car_on = true
    let before = base_months()
    let after = buffer_months()
    prompt = "缓冲从 " + fmt_num(before) + " 个月变成 " + fmt_num(after) + " 个月。"
    save()
    ui.board.render()
}

fn set_rest(n) {
    sim = "rest"
    rest_months = n
    let buf = buffer_months()
    prompt = "休息 " + fmt_num(n) + " 个月，缓冲剩 " + fmt_num(buf) + " 个月。"
    save()
    ui.board.render()
}

fn hold_cash() {
    car_held = true
    car_on = false
    sim = "now"
    remember("考虑过买" + wan_text(car_wan) + "的车，先留着")
    let buf = buffer_months()
    prompt = "好，这笔钱先留着。缓冲回到 " + fmt_num(buf) + " 个月。我记下了。"
    save()
    ui.board.render()
}

fn look_jobless() {
    let spend = necessary()
    let line_cash = needed_for_safety()
    let cash = cash_now()
    if line_cash == nil || cash == nil || spend == nil { return }
    if cash <= line_cash {
        prompt = "按现在的状态，就算不买车，如果收入中断，缓冲已经不够你设的 " + fmt_num(safety) + " 个月底线了。"
    } else {
        let left = cash - line_cash
        let months_left = left / spend
        prompt = "如果买完就没有收入，大约 " + fmt_num(months_left) + " 个月后会碰到你设的 " + fmt_num(safety) + " 个月底线。"
    }
    save()
    ui.board.render()
}

fn wait_second() {
    car_held = true
    car_on = false
    sim = "now"
    remember("等家里有第二份收入再花")
    let buf = buffer_months()
    prompt = "好。等家里多一份收入再买。缓冲按现在的算，是 " + fmt_num(buf) + " 个月。"
    save()
    ui.board.render()
}

start_timeout(0.05, || g8_init())




let ink = #x292d33
let muted = #x77746f
let paper = #xf1eee8
let card_bg = #xfaf9f6
let leaf = #x596c82
let leaf_dark = #x4a5b6e
let warn_bg = #xf3ede4
let warn_c = #x9b8060
let danger_bg = #xf7eaea
let danger_c = #xb45c5c
let margin_c = #x596c82
let blue_c = #x64748b

SolidView{width: Fill height: Fill flow: Down padding: 12 spacing: 8 draw_bg.color: paper
    Label{text: "兜兜" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 22}}
    Label{text: "帮你看着家里的底" draw_text.color: muted draw_text.text_style.font_size: 13}

    View{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5}
        entry := TextInput{width: Fill height: 40 empty_text: "说一句你的情况，不用填表"
            draw_bg +: {color: card_bg color_hover: card_bg color_focus: card_bg color_empty: card_bg border_radius: 20.0}
            draw_text +: {color: ink color_hover: ink color_focus: ink color_empty: muted color_empty_hover: muted}}
        ButtonFlat{text: "听懂了" height: 40 padding: Inset{left: 14 right: 14} on_click: || g8_on_submit_text()
            draw_bg +: {border_radius: 20.0 color: leaf color_hover: #x6b7d92 color_down: #x4a5b6e border_size: 0.0}
            draw_text +: {color: #xffffff color_hover: #xffffff color_down: #xffffff}}
    }

    board := View{width: Fill height: Fill flow: Down spacing: 8 on_render: || {
        let vs = g8_view_state
        if vs.household == nil {
            ScrollYView{width: Fill height: Fill flow: Down spacing: 8
            if vs.screen == G8_ONBOARD && vs.onboard_step != nil {
                let ostep = vs.onboard_step
                let odef = g8_onboard_step_def(ostep)
                let obtn = "继续"
                if ostep >= 4 { obtn = "完成" }
                RoundedView{width: Fill height: Fit flow: Down padding: 18 spacing: 6 draw_bg.color: card_bg
                    Label{text: "先看看，你的家能稳稳走多久。" draw_text.color: leaf draw_text.text_style: theme.font_bold{font_size: 18}}
                }
                RoundedView{width: Fill height: Fit flow: Down padding: 16 spacing: 6 draw_bg.color: card_bg
                    Label{text: "第 " + (ostep + 1) + " / 5 步 · " + odef.label draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 15}}
                    Label{width: Fill text: odef.hint draw_text.color: muted draw_text.text_style.font_size: 13}
                    Label{width: Fill text: "在顶部输入框填写数字，然后点「继续」。" draw_text.color: muted draw_text.text_style.font_size: 12}
                    if vs.onboard_error != nil {
                        Label{width: Fill text: vs.onboard_error draw_text.color: danger_c draw_text.text_style.font_size: 13}
                    }
                    View{width: Fill height: Fit flow: Right spacing: 6
                        ButtonFlat{text: "← 返回" height: 36 padding: Inset{left: 14 right: 14} on_click: || g8_on_click_onboard_back()
                            draw_bg +: {border_radius: 18.0 color: #xffffff color_hover: #xefede8 color_down: #xdcd7cf border_size: 1.0 border_color: leaf}
                            draw_text +: {color: leaf}}
                        ButtonFlat{text: obtn height: 36 padding: Inset{left: 18 right: 18} on_click: || g8_on_click_onboard_next()
                            draw_bg +: {border_radius: 18.0 color: leaf color_hover: leaf_dark border_size: 0.0}
                            draw_text +: {color: #xffffff}}
                    }
                }
            } else {
                RoundedView{width: Fill height: Fit flow: Down padding: 18 spacing: 8 draw_bg.color: card_bg
                    View{width: Fill height: Fit flow: Down align: Align{x: 0.5}
                        Image{width: 160 height: 180 fit: ImageFit.Smallest src: http_resource("{{assets}}/mascot_hug.png")}
                    }
                    Label{text: "先看看，你的家能稳稳走多久。" draw_text.color: leaf draw_text.text_style: theme.font_bold{font_size: 18}}
                    Label{width: Fill text: "只需要几个数字，就能估算家庭现金安全垫。不需要连接银行，数据只留在这台设备上。" draw_text.color: muted draw_text.text_style.font_size: 13}
                }
                RoundedView{width: Fill height: Fit flow: Down padding: 16 spacing: 6 draw_bg.color: card_bg
                    ButtonFlat{text: "建立我的家庭情况" width: Fill height: 40 on_click: || g8_on_click_onboard_start()
                        draw_bg +: {border_radius: 20.0 color: leaf color_hover: leaf_dark border_size: 0.0}
                        draw_text +: {color: #xffffff}}
                    ButtonFlat{text: "先体验示例" width: Fill height: 40 on_click: || g8_on_click_onboard_demo()
                        draw_bg +: {border_radius: 20.0 color: #xffffff color_hover: #xefede8 color_down: #xdcd7cf border_size: 1.0 border_color: leaf}
                        draw_text +: {color: leaf}}
                    Label{width: Fill text: "示例数据不会保存，随时可以用真实数字替代。" draw_text.color: muted draw_text.text_style.font_size: 12}
                }
            }
            }
        } else if vs.screen == G8_IDLE {
            ScrollYView{width: Fill height: Fill flow: Down spacing: 8
            View{width: Fill height: Fit flow: Down align: Align{x: 0.5}
                Image{width: 64 height: 64 fit: ImageFit.Smallest src: http_resource("{{assets}}/mascot_hug_badge.png")}
            }
            if vs.household_is_demo {
                RoundedView{width: Fill height: Fit flow: Down padding: 12 spacing: 6 draw_bg.color: warn_bg
                    Label{width: Fill text: "正在体验示例数据（不会保存）" draw_text.color: warn_c draw_text.text_style: theme.font_bold{font_size: 14}}
                    ButtonFlat{text: "建立我的家庭情况" width: Fit height: 32 padding: Inset{left: 12 right: 12} on_click: || g8_on_click_onboard_start()
                        draw_bg +: {border_radius: 16.0 color: #xffffff color_hover: #xefede8 color_down: #xdcd7cf border_size: 1.0 border_color: leaf}
                        draw_text +: {color: leaf}}
                }
            }
            let h = vs.household
            let nec = h.mortgage + h.living
            let buf = h.liquid_cash / nec
            let safety = h.safety_floor_months
            let marg = buf - safety
            let level = "ok"
            if buf < safety { level = "danger" }
            else {
                if marg < 6.0 { level = "warn" }
            }
            let tag = "稳定"
            let tag_color = margin_c
            if level == "danger" { tag = "跌破底线"; tag_color = danger_c }
            if level == "warn" { tag = "接近底线"; tag_color = warn_c }
            RoundedView{width: Fill height: Fit flow: Down padding: 16 spacing: 4 draw_bg.color: card_bg
                View{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5}
                    Label{text: fmt_num(buf) draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 48}}
                    Label{text: "个月" draw_text.color: muted draw_text.text_style.font_size: 16}
                    RoundedView{width: Fit height: Fit padding: Inset{left: 10 right: 10} draw_bg.color: tag_color
                        Label{text: tag draw_text.color: #xffffff draw_text.text_style.font_size: 12}
                    }
                }
                Label{width: Fill text: "如果突然没有收入，按现在的基本开销还能撑这么久" draw_text.color: muted draw_text.text_style.font_size: 13}
                Label{text: "安全底线：" + fmt_num(safety) + " 个月" draw_text.color: muted draw_text.text_style.font_size: 13}
                Label{width: Fill text: "现在距离底线还有 " + fmt_num(marg) + " 个月" draw_text.color: margin_c draw_text.text_style: theme.font_bold{font_size: 15}}
                SolidView{width: Fill height: 1 draw_bg.color: #xdcd7cf}
                View{width: Fill height: Fit flow: Right spacing: 16
                    Label{text: "流动现金 " + fmt_wan(h.liquid_cash) draw_text.color: ink draw_text.text_style.font_size: 13}
                    Label{text: "每月必要支出 " + fmt_wan(nec) draw_text.color: ink draw_text.text_style.font_size: 13}
                }
                ButtonFlat{text: "数字怎么来的 →" width: Fit height: 32 padding: Inset{left: 12 right: 12} on_click: || g8_on_click_calc()
                    draw_bg +: {border_radius: 16.0 color: #xffffff color_hover: #xefede8 color_down: #xdcd7cf border_size: 1.0 border_color: leaf}
                    draw_text +: {color: leaf}}
            }
            RoundedView{width: Fill height: Fit flow: Down padding: 12 spacing: 6 draw_bg.color: card_bg
                Label{text: "模拟一次生活变化" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 13}}
                View{width: Fill height: Fit flow: Right spacing: 6
                    ButtonFlat{text: "保持现状" height: 36 padding: Inset{left: 14 right: 14} on_click: || g8_on_click_now()
                        draw_bg +: {border_radius: 18.0 color: #xffffff color_hover: #xefede8 color_down: #xdcd7cf border_size: 1.0 border_color: leaf}
                        draw_text +: {color: leaf}}
                }
                View{width: Fill height: Fit flow: Right spacing: 6
                    ButtonFlat{text: "买车" height: 36 padding: Inset{left: 14 right: 14} on_click: || g8_on_click_scenario_preset("买辆 30 万的车")
                        draw_bg +: {border_radius: 18.0 color: leaf color_hover: #x6b7d92 color_down: #x4a5b6e border_size: 0.0}
                        draw_text +: {color: #xffffff}}
                    ButtonFlat{text: "休息 6M" height: 36 padding: Inset{left: 12 right: 12} on_click: || g8_on_click_scenario_rest(6)
                        draw_bg +: {border_radius: 18.0 color: leaf color_hover: #x6b7d92 color_down: #x4a5b6e border_size: 0.0}
                        draw_text +: {color: #xffffff}}
                    ButtonFlat{text: "休息 18M" height: 36 padding: Inset{left: 12 right: 12} on_click: || g8_on_click_scenario_rest(18)
                        draw_bg +: {border_radius: 18.0 color: leaf color_hover: #x6b7d92 color_down: #x4a5b6e border_size: 0.0}
                        draw_text +: {color: #xffffff}}
                }
                View{width: Fill height: Fit flow: Right spacing: 6
                    ButtonFlat{text: "自定义事件 →" width: Fill height: 36 on_click: || g8_on_click_ev_start()
                        draw_bg +: {border_radius: 18.0 color: #xffffff color_hover: #xefede8 color_down: #xdcd7cf border_size: 1.0 border_color: leaf}
                        draw_text +: {color: leaf}}
                }
            }
            RoundedView{width: Fill height: Fit flow: Down padding: 12 spacing: 3 draw_bg.color: card_bg
                Label{text: "家庭档案与记录" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 13}}
                Label{width: Fill text: "收入 " + wan_text(h.monthly_income) + "/月 · 存款 " + wan_text(h.liquid_cash) + " · 房贷 " + wan_text(h.mortgage) + " · 生活 " + wan_text(h.living) draw_text.color: muted draw_text.text_style.font_size: 13}
                SolidView{width: Fill height: 1 draw_bg.color: #xdcd7cf}
                let rec_count = vs.recent_decisions.len()
                if rec_count == 0 {
                    Label{width: Fill text: "还没有记录 — 试试看会发生什么，然后做一个决定。" draw_text.color: muted draw_text.text_style.font_size: 12}
                }
                if rec_count > 0 {
                    for i in rec_count {
                        let r = vs.recent_decisions[i]
                        let choice_label = "做了"
                        if r.user_choice == "decline" { choice_label = "先留着" }
                        if r.user_choice == "defer" { choice_label = "等一等" }
                        let type_label = "一次决定"
                        if r.scenario_id == "sc_rest" { type_label = "一次休息的决定" }
                        if r.scenario_id == "sc_car" { type_label = "一次买车的决定" }
                        if r.scenario_id == "sc_inc" { type_label = "一次收入变化的决定" }
                        if r.scenario_id == "sc_exp" { type_label = "一次支出变化的决定" }
                        let buf_str = fmt_num(r.snapshot.buffer_months)
                        let date_str = r.created_at
                        Label{width: Fill text: type_label + " · 当时安全垫 " + buf_str + " 个月 · " + choice_label + " · " + date_str draw_text.color: ink draw_text.text_style.font_size: 12}
                    }
                }
            }
            }
        } else if vs.screen == G8_NEED_CLARIFICATION {
            ScrollYView{width: Fill height: Fill flow: Down spacing: 8
            if vs.clarification != nil {
                RoundedView{width: Fill height: Fit flow: Down padding: 18 spacing: 8 draw_bg.color: warn_bg
                    Label{text: vs.clarification.question draw_text.color: warn_c draw_text.text_style: theme.font_bold{font_size: 16}}
                }
            }
            }
        } else if vs.screen == G8_PARSE_FAILURE {
            ScrollYView{width: Fill height: Fill flow: Down spacing: 8
            RoundedView{width: Fill height: Fit flow: Down padding: 18 spacing: 8 draw_bg.color: danger_bg
                Label{text: "我没听懂你说的，再试一次？" draw_text.color: danger_c draw_text.text_style: theme.font_bold{font_size: 16}}
            }
            }
        } else if vs.screen == G8_VALIDATION_FAILURE {
            ScrollYView{width: Fill height: Fill flow: Down spacing: 8
            RoundedView{width: Fill height: Fit flow: Down padding: 18 spacing: 8 draw_bg.color: danger_bg
                Label{text: "输入有误，请检查" draw_text.color: danger_c draw_text.text_style: theme.font_bold{font_size: 16}}
            }
            }
        } else if vs.screen == G8_EVENT_DRAFT {
            ScrollYView{width: Fill height: Fill flow: Down spacing: 8
            let d = vs.ev_draft
            let d_type = ""
            let d_title = ""
            let d_inc = nil
            let d_exp = nil
            let d_one = nil
            let d_dur = nil
            if d != nil {
                d_type = d.event_type
                d_title = d.title
                d_inc = d.monthly_income_delta
                d_exp = d.monthly_expense_delta
                d_one = d.one_time_cash_delta
                d_dur = d.duration_months
            }
            let title_str = "未填"
            if d_title != nil && d_title != "" { title_str = d_title }
            let inc_str = "未填"
            if d_inc != nil { inc_str = fmt_yuan(d_inc) }
            let exp_str = "未填"
            if d_exp != nil { exp_str = fmt_yuan(d_exp) }
            let one_str = "未填"
            if d_one != nil { one_str = fmt_yuan(d_one) }
            let dur_str = "未填"
            if d_dur != nil { dur_str = fmt_num(d_dur) }
            let cur_label = ev_type_label(d_type)
            ButtonFlat{text: "← 回到现在" height: 36 padding: Inset{left: 14 right: 14} on_click: || g8_on_click_now()
                draw_bg +: {border_radius: 18.0 color: #xffffff color_hover: #xefede8 color_down: #xdcd7cf border_size: 1.0 border_color: leaf}
                draw_text +: {color: leaf}}
            RoundedView{width: Fill height: Fit flow: Down padding: 16 spacing: 5 draw_bg.color: card_bg
                Label{text: "自定义事件 · 不用 AI 也能算" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 16}}
                Label{width: Fill text: "① 选类型 ② 在顶部输入框填数字 ③ 点对应按钮 ④ 确认并计算。全程由代码计算，不经过任何模型。" draw_text.color: muted draw_text.text_style.font_size: 12}
                Label{width: Fill text: "当前类型：" + cur_label draw_text.color: leaf draw_text.text_style: theme.font_bold{font_size: 13}}
            }
            RoundedView{width: Fill height: Fit flow: Down padding: 14 spacing: 6 draw_bg.color: card_bg
                Label{text: "① 事件类型" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 13}}
                View{width: Fill height: Fit flow: Right spacing: 6
                    ButtonFlat{text: "收入中断" height: 30 padding: Inset{left: 9 right: 9} on_click: || g8_on_click_ev_type("income_loss")
                        draw_bg +: {border_radius: 15.0 color: #xffffff color_hover: #xefede8 border_size: 1.0 border_color: leaf} draw_text +: {color: leaf}}
                    ButtonFlat{text: "收入变化" height: 30 padding: Inset{left: 9 right: 9} on_click: || g8_on_click_ev_type("income_change")
                        draw_bg +: {border_radius: 15.0 color: #xffffff color_hover: #xefede8 border_size: 1.0 border_color: leaf} draw_text +: {color: leaf}}
                    ButtonFlat{text: "一次性购买" height: 30 padding: Inset{left: 9 right: 9} on_click: || g8_on_click_ev_type("purchase")
                        draw_bg +: {border_radius: 15.0 color: #xffffff color_hover: #xefede8 border_size: 1.0 border_color: leaf} draw_text +: {color: leaf}}
                    ButtonFlat{text: "医疗支出" height: 30 padding: Inset{left: 9 right: 9} on_click: || g8_on_click_ev_type("medical_cost")
                        draw_bg +: {border_radius: 15.0 color: #xffffff color_hover: #xefede8 border_size: 1.0 border_color: leaf} draw_text +: {color: leaf}}
                }
                View{width: Fill height: Fit flow: Right spacing: 6
                    ButtonFlat{text: "教育支出" height: 30 padding: Inset{left: 9 right: 9} on_click: || g8_on_click_ev_type("education_cost")
                        draw_bg +: {border_radius: 15.0 color: #xffffff color_hover: #xefede8 border_size: 1.0 border_color: leaf} draw_text +: {color: leaf}}
                    ButtonFlat{text: "照护支出" height: 30 padding: Inset{left: 9 right: 9} on_click: || g8_on_click_ev_type("caregiving")
                        draw_bg +: {border_radius: 15.0 color: #xffffff color_hover: #xefede8 border_size: 1.0 border_color: leaf} draw_text +: {color: leaf}}
                    ButtonFlat{text: "其他" height: 30 padding: Inset{left: 9 right: 9} on_click: || g8_on_click_ev_type("other")
                        draw_bg +: {border_radius: 15.0 color: #xffffff color_hover: #xefede8 border_size: 1.0 border_color: leaf} draw_text +: {color: leaf}}
                }
            }
            RoundedView{width: Fill height: Fit flow: Down padding: 14 spacing: 6 draw_bg.color: card_bg
                Label{text: "② 数值（在顶部输入框填数字，再点按钮）" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 13}}
                View{width: Fill height: Fit flow: Right spacing: 6
                    ButtonFlat{text: "名称：" + title_str width: Fill height: 32 padding: Inset{left: 10 right: 10} on_click: || g8_on_click_ev_set("title")
                        draw_bg +: {border_radius: 16.0 color: #xffffff color_hover: #xefede8 border_size: 1.0 border_color: leaf} draw_text +: {color: leaf}}
                    ButtonFlat{text: "持续月数：" + dur_str height: 32 padding: Inset{left: 10 right: 10} on_click: || g8_on_click_ev_set("duration")
                        draw_bg +: {border_radius: 16.0 color: #xffffff color_hover: #xefede8 border_size: 1.0 border_color: leaf} draw_text +: {color: leaf}}
                }
                View{width: Fill height: Fit flow: Right spacing: 6
                    ButtonFlat{text: "每月收入变化：" + inc_str width: Fill height: 32 padding: Inset{left: 10 right: 10} on_click: || g8_on_click_ev_set("income")
                        draw_bg +: {border_radius: 16.0 color: #xffffff color_hover: #xefede8 border_size: 1.0 border_color: leaf} draw_text +: {color: leaf}}
                    ButtonFlat{text: "每月支出变化：" + exp_str width: Fill height: 32 padding: Inset{left: 10 right: 10} on_click: || g8_on_click_ev_set("expense")
                        draw_bg +: {border_radius: 16.0 color: #xffffff color_hover: #xefede8 border_size: 1.0 border_color: leaf} draw_text +: {color: leaf}}
                }
                View{width: Fill height: Fit flow: Right spacing: 6
                    ButtonFlat{text: "一次性现金变化：" + one_str width: Fill height: 32 padding: Inset{left: 10 right: 10} on_click: || g8_on_click_ev_set("one")
                        draw_bg +: {border_radius: 16.0 color: #xffffff color_hover: #xefede8 border_size: 1.0 border_color: leaf} draw_text +: {color: leaf}}
                }
                Label{width: Fill text: "收入增加填正数、减少填负数（收入中断要填负的收入额）；支出增加填正数；一次性流出填负数。留空按 0 处理。" draw_text.color: muted draw_text.text_style.font_size: 11}
            }
            RoundedView{width: Fill height: Fit flow: Down padding: 14 spacing: 6 draw_bg.color: card_bg
                if vs.ev_error != nil {
                    Label{width: Fill text: vs.ev_error draw_text.color: danger_c draw_text.text_style.font_size: 13}
                }
                if vs.ev_note != nil && vs.ev_note != "" {
                    Label{width: Fill text: vs.ev_note draw_text.color: leaf draw_text.text_style.font_size: 12}
                }
                ButtonFlat{text: "确认并计算 →" width: Fill height: 40 on_click: || g8_on_click_ev_confirm()
                    draw_bg +: {border_radius: 20.0 color: leaf color_hover: leaf_dark border_size: 0.0}
                    draw_text +: {color: #xffffff}}
                Label{width: Fill text: "确认后交给原有确定性引擎计算 —— 结果不是模型算出来的。" draw_text.color: muted draw_text.text_style.font_size: 11}
            }
            RoundedView{width: Fill height: Fit flow: Down padding: 14 spacing: 6 draw_bg.color: warn_bg
                Label{text: "③ AI 解析（可选 · 当前可能不可用）" draw_text.color: warn_c draw_text.text_style: theme.font_bold{font_size: 13}}
                Label{width: Fill text: "把 AI 返回的事件 JSON 粘到顶部输入框，点「导入 AI 草稿」，它会变成上面可编辑的草稿（不会直接计算）。" draw_text.color: muted draw_text.text_style.font_size: 11}
                View{width: Fill height: Fit flow: Right spacing: 6
                    ButtonFlat{text: "导入 AI 草稿" height: 32 padding: Inset{left: 12 right: 12} on_click: || g8_on_click_ev_ai_ingest()
                        draw_bg +: {border_radius: 16.0 color: #xffffff color_hover: #xefede8 border_size: 1.0 border_color: warn_c} draw_text +: {color: warn_c}}
                    ButtonFlat{text: "检查 AI 通道" height: 32 padding: Inset{left: 12 right: 12} on_click: || g8_on_click_ev_ai()
                        draw_bg +: {border_radius: 16.0 color: #xffffff color_hover: #xefede8 border_size: 1.0 border_color: warn_c} draw_text +: {color: warn_c}}
                }
                if vs.ev_ai_message != nil {
                    Label{width: Fill text: vs.ev_ai_message draw_text.color: warn_c draw_text.text_style.font_size: 11}
                }
            }
            }
        } else if vs.screen == G8_RESULT {
            ScrollYView{width: Fill height: Fill flow: Down spacing: 8
            let sr = vs.simulation_result
            if sr != nil {
                ButtonFlat{text: "← 回到现在" height: 36 padding: Inset{left: 14 right: 14} on_click: || g8_on_click_now()
                    draw_bg +: {border_radius: 18.0 color: #xffffff color_hover: #xefede8 color_down: #xdcd7cf border_size: 1.0 border_color: leaf}
                    draw_text +: {color: leaf}}
                let scenario_buf = sr.scenario_path.buffer_at_horizon
                let safety = vs.household.safety_floor_months
                let monthly_necessary = vs.household.mortgage + vs.household.living
                let baseline_buf = vs.household.liquid_cash / monthly_necessary
                let level = vs.policy_status_scenario
                let tag = "稳定"
                let tag_color = margin_c
                if level == "danger" { tag = "跌破底线"; tag_color = danger_c }
                if level == "warn" { tag = "接近底线"; tag_color = warn_c }
                let buffer_delta = scenario_buf - baseline_buf
                let distance_after = scenario_buf - safety
                Label{width: Fill text: g8_scenario_label(vs.scenario_summary) + "：这段变化，会怎样影响家庭现金安全？" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 15}}
                if sr.scenario_path.breach_month == nil {
                    Label{width: Fill text: "预测期内不会跌破 " + fmt_num(safety) + " 个月安全底线。" draw_text.color: margin_c draw_text.text_style.font_size: 14}
                } else {
                    Label{width: Fill text: "预计第 " + fmt_num(sr.scenario_path.breach_month) + " 个月跌破 " + fmt_num(safety) + " 个月安全底线。" draw_text.color: danger_c draw_text.text_style: theme.font_bold{font_size: 14}}
                }
                RoundedView{width: Fill height: Fit flow: Down padding: 16 spacing: 4 draw_bg.color: card_bg
                    View{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5}
                        Label{text: fmt_num(scenario_buf) draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 48}}
                        Label{text: "个月" draw_text.color: muted draw_text.text_style.font_size: 16}
                        RoundedView{width: Fit height: Fit padding: Inset{left: 10 right: 10} draw_bg.color: tag_color
                            Label{text: tag draw_text.color: #xffffff draw_text.text_style.font_size: 12}
                        }
                    }
                    Label{width: Fill text: "期末现金 " + fmt_wan(sr.scenario_path.cash_at_horizon) draw_text.color: muted draw_text.text_style.font_size: 13}
                }
                let rtr = try { sr.trace } { nil }
                if rtr != nil && rtr.len() > 1 {
                    let rbi = try { sr.scenario_path.breach_month } { 0 - 1 }
                    let cs = g8_cash_plot_model(rtr, monthly_necessary * safety, 250.0, 130.0, g8_clamp_month(vs), rbi)
                    RoundedView{width: Fill height: Fit flow: Down padding: 12 spacing: 4 draw_bg.color: card_bg
                        View{width: Fill height: Fit flow: Right spacing: 10 align: Align{y: 0.5}
                            SolidView{width: 10 height: 10 draw_bg.color: G8_C_BASE}
                            Label{text: "基准" draw_text.color: muted draw_text.text_style.font_size: 11}
                            SolidView{width: 10 height: 10 draw_bg.color: leaf}
                            Label{text: "这次变化" draw_text.color: muted draw_text.text_style.font_size: 11}
                            SolidView{width: 14 height: 2 draw_bg.color: danger_c}
                            Label{text: "安全底线" draw_text.color: muted draw_text.text_style.font_size: 11}}
                        Label{width: Fill text: "纵轴 " + fmt_wan(cs.min_v) + " ~ " + fmt_wan(cs.max_v) + " · 红线 = " + fmt_wan(monthly_necessary * safety) draw_text.color: muted draw_text.text_style.font_size: 10}
                        View{width: Fill height: Fit flow: Down spacing: 0
                            View{width: Fill height: cs.h_above flow: Right spacing: 2 align: Align{y: 1.0}
                                for i in rtr.len() {
                                    let rv = rtr[i]
                                    let bq = g8poz((rv.baseline.ending_cash - monthly_necessary * safety) * cs.unit)
                                    let sq = g8poz((rv.scenario.ending_cash - monthly_necessary * safety) * cs.unit)
                                    View{width: Fill height: Fill flow: Right spacing: 1 align: Align{y: 1.0}
                                        SolidView{width: Fill height: bq draw_bg.color: G8_C_BASE}
                                        SolidView{width: Fill height: sq draw_bg.color: leaf}
                                    }
                                }
                            }
                            SolidView{width: Fill height: 2 draw_bg.color: danger_c}
                            View{width: Fill height: cs.h_below flow: Right spacing: 2
                                for i in rtr.len() {
                                    let rv = rtr[i]
                                    let bd2 = g8poz((monthly_necessary * safety - rv.baseline.ending_cash) * cs.unit)
                                    let sd2 = g8poz((monthly_necessary * safety - rv.scenario.ending_cash) * cs.unit)
                                    View{width: Fill height: Fill flow: Right spacing: 1
                                        SolidView{width: Fill height: bd2 draw_bg.color: G8_C_BASE}
                                        SolidView{width: Fill height: sd2 draw_bg.color: leaf}
                                    }
                                }
                            }
                        }
                        View{width: Fill height: Fit flow: Right spacing: 2
                            for i in rtr.len() {
                                let mt = ""
                                if i == 0 { mt = "起" }
                                if i > 0 && i % 6 == 0 { mt = "" + i }
                                let mcol = muted
                                if i == cs.sel { mcol = ink }
                                if i == rbi { mt = "▼" + i mcol = danger_c }
                                Label{width: Fill text: mt draw_text.color: mcol draw_text.text_style: theme.font_bold{font_size: 9}}
                            }
                        }
                        SolidView{width: Fill height: 1 draw_bg.color: #xdcd7cf}
                        Label{width: Fill text: "最低点：第 " + fmt_num(cs.min_i) + " 月 · 期末现金 " + fmt_wan(cs.min_cash) draw_text.color: muted draw_text.text_style.font_size: 11}
                        if cs.ot_i >= 0 {
                            Label{width: Fill text: "一次性支出：第 " + fmt_num(cs.ot_i) + " 月 " + fmt_wan(0 - rtr[cs.ot_i].scenario.one_time_expense) draw_text.color: warn_c draw_text.text_style.font_size: 11}
                        }
                        if cs.conflict == 1 {
                            Label{width: Fill text: "提示：引擎破底结果与轨迹数据不一致" draw_text.color: danger_c draw_text.text_style.font_size: 11}
                        }
                        let edur = try { vs.scenario_summary.duration_months } { 0 }
                        if edur > 0 {
                            Label{width: Fill text: "事件期：第 1 – " + fmt_num(edur) + " 月" draw_text.color: warn_c draw_text.text_style.font_size: 11}
                        }
                    }
                }
                RoundedView{width: Fill height: Fit flow: Down padding: 12 spacing: 4 draw_bg.color: card_bg
                    Label{width: Fill text: "与不休息相比：安全垫 " + fmt_num(baseline_buf) + " → " + fmt_num(scenario_buf) + " 个月（少了 " + fmt_num(0 - buffer_delta) + " 个月）· 期末现金差 " + fmt_wan(sr.scenario_path.cash_at_horizon - sr.baseline_path.cash_at_horizon) + "。变化来自 " + g8_scenario_label(vs.scenario_summary) draw_text.color: ink draw_text.text_style.font_size: 13}
                    View{width: Fill height: Fit flow: Right spacing: 6
                        ButtonFlat{text: "逐月查看 →" height: 32 padding: Inset{left: 12 right: 12} on_click: || g8_on_click_flow()
                            draw_bg +: {border_radius: 16.0 color: #xffffff color_hover: #xefede8 color_down: #xdcd7cf border_size: 1.0 border_color: leaf}
                            draw_text +: {color: leaf}}
                        ButtonFlat{text: "数字怎么来的 →" height: 32 padding: Inset{left: 12 right: 12} on_click: || g8_on_click_calc()
                            draw_bg +: {border_radius: 16.0 color: #ffffff color_hover: #xefede8 color_down: #xdcd7cf border_size: 1.0 border_color: leaf}
                            draw_text +: {color: leaf}}
                        ButtonFlat{text: "修改假设" height: 32 padding: Inset{left: 12 right: 12} on_click: || flow_set_screen(G8_IDLE)
                            draw_bg +: {border_radius: 16.0 color: #ffffff color_hover: #xefede8 color_down: #xdcd7cf border_size: 1.0 border_color: leaf}
                            draw_text +: {color: leaf}}
                    }
                }
                RoundedView{width: Fill height: Fit flow: Down padding: 12 spacing: 8 draw_bg.color: card_bg
                    Label{text: "做决定" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 13}}
                    View{width: Fill height: Fit flow: Right spacing: 6
                        ButtonFlat{text: "先留着" width: Fill height: 36 on_click: || g8_on_click_decide("decline")
                            draw_bg +: {border_radius: 18.0 color: leaf color_hover: leaf_dark border_size: 0.0}
                            draw_text +: {color: #xffffff}}
                        ButtonFlat{text: "等一等" width: Fill height: 36 on_click: || g8_on_click_decide("defer")
                            draw_bg +: {border_radius: 18.0 color: blue_c border_size: 0.0}
                            draw_text +: {color: #xffffff}}
                        ButtonFlat{text: "做下去" width: Fill height: 36 on_click: || g8_on_click_decide("accept")
                            draw_bg +: {border_radius: 18.0 color: leaf_dark border_size: 0.0}
                            draw_text +: {color: #xffffff}}
                    }
                }
            }
            }
        } else if vs.screen == G8_FLOW {
            ScrollYView{width: Fill height: Fill flow: Down spacing: 8
            let sr = vs.simulation_result
            let tr = try { sr.trace } { nil }
            View{width: Fill height: Fit flow: Right spacing: 6
                ButtonFlat{text: "← 回到结果" height: 36 padding: Inset{left: 14 right: 14} on_click: || g8_on_click_back_result()
                    draw_bg +: {border_radius: 18.0 color: #ffffff color_hover: #xefede8 color_down: #xdcd7cf border_size: 1.0 border_color: leaf}
                    draw_text +: {color: leaf}}
                ButtonFlat{text: "← 回到现在" height: 36 padding: Inset{left: 14 right: 14} on_click: || g8_on_click_now()
                    draw_bg +: {border_radius: 18.0 color: #ffffff color_hover: #xefede8 color_down: #xdcd7cf border_size: 1.0 border_color: leaf}
                    draw_text +: {color: leaf}}
            }
            if sr == nil || tr == nil || tr.len() == 0 {
                Label{width: Fill text: "还没有可展示的逐月推演 — 先在结果页跑一次模拟。" draw_text.color: warn_c draw_text.text_style: theme.font_bold{font_size: 14}}
            } else {
                let h = vs.household
                let floor_cash = (h.mortgage + h.living) * h.safety_floor_months
                let fbi = try { sr.scenario_path.breach_month } { 0 - 1 }
                let cs = g8_cash_plot_model(tr, floor_cash, 250.0, 130.0, g8_clamp_month(vs), fbi)
                Label{text: "未来 " + fmt_num(tr.len() - 1) + " 个月，现金会怎样变化？" draw_text.color: leaf draw_text.text_style: theme.font_bold{font_size: 16}}
                let smi = g8_clamp_month(vs)
                let row = tr[smi]
                let stxt = "当月现金流正常"
                let scol2 = margin_c
                if row.scenario.net_change < 0 { stxt = "当月入不敷出，由现金垫补足" scol2 = warn_c }
                if row.scenario.buffer_months < h.safety_floor_months { stxt = "安全垫跌破 " + fmt_num(h.safety_floor_months) + " 个月底线" scol2 = danger_c }
                if row.scenario.ending_cash < 0 { stxt = "现金为负：可用资金不足" scol2 = danger_c }
                View{width: Fill height: Fit flow: Right spacing: 6 align: Align{y: 0.5}
                    ButtonFlat{text: "◀ 上一月" height: 32 padding: Inset{left: 12 right: 12} on_click: || g8_on_click_month_step(0 - 1)
                        draw_bg +: {border_radius: 16.0 color: #ffffff color_hover: #xefede8 color_down: #xdcd7cf border_size: 1.0 border_color: leaf}
                        draw_text +: {color: leaf}}
                    Label{width: Fill text: "第 " + fmt_num(smi) + " 月" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 15}}
                    ButtonFlat{text: "下一月 ▶" height: 32 padding: Inset{left: 12 right: 12} on_click: || g8_on_click_month_step(1)
                        draw_bg +: {border_radius: 16.0 color: #ffffff color_hover: #xefede8 color_down: #xdcd7cf border_size: 1.0 border_color: leaf}
                        draw_text +: {color: leaf}}
                }
                RoundedView{width: Fill height: Fit flow: Down padding: 12 spacing: 3 draw_bg.color: card_bg
                    Label{width: Fill text: stxt draw_text.color: scol2 draw_text.text_style: theme.font_bold{font_size: 13}}
                    Label{width: Fill text: "期初 " + fmt_wan(row.scenario.opening_cash) + " → 期末 " + fmt_wan(row.scenario.ending_cash) + "｜净 " + fmt_wan(row.scenario.net_change) draw_text.color: ink draw_text.text_style.font_size: 13}
                    Label{width: Fill text: "收入 " + fmt_wan(row.scenario.income) + " · 房贷 " + fmt_wan(row.scenario.mortgage_expense) + " · 生活 " + fmt_wan(row.scenario.living_expense) + " · 调整 " + fmt_wan(row.scenario.expense_adjustment) + " · 一次性 " + fmt_wan(row.scenario.one_time_expense) draw_text.color: muted draw_text.text_style.font_size: 12}
                }
                let fcs = g8_chart_scale(tr, floor_cash)
                let frx = g8poz((floor_cash / fcs.max_v) * 250.0)
                if frx > 246 { frx = 246 }
                RoundedView{width: Fill height: Fit flow: Down padding: 12 spacing: 3 draw_bg.color: card_bg
                    Label{text: "逐月一览（条长 = 期末现金，红条 = 低于底线）" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 13}}
                    View{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5} padding: Inset{left: 2 right: 2}
                        Label{width: 58 text: "安全底线" draw_text.color: muted draw_text.text_style.font_size: 10}
                        View{width: frx height: Fit align: Align{x: 1.0}
                            SolidView{width: 2 height: 10 draw_bg.color: danger_c}
                        }
                    }
                    for i in tr.len() {
                        let rv = tr[i]
                        let mt = "起"
                        if i > 0 { mt = "第 " + fmt_num(i) + " 月" }
                        let bw = g8poz((rv.scenario.ending_cash / fcs.max_v) * 250.0)
                        let bcol = leaf
                        if rv.scenario.ending_cash < floor_cash { bcol = danger_c }
                        let mcol = muted
                        let rowbg = card_bg
                        if i == smi { mcol = ink rowbg = #xefede8 }
                        let mline = fmt_wan(rv.scenario.ending_cash) + "｜净 " + fmt_wan(rv.scenario.net_change)
                        if i == fbi { mline = mline + " ▼ 首次跌破" }
                        RoundedView{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5} padding: Inset{left: 2 right: 2} draw_bg.color: rowbg
                            Label{width: 58 text: mt draw_text.color: mcol draw_text.text_style.font_size: 12}
                            SolidView{width: bw height: 8 draw_bg.color: bcol}
                            Label{width: Fill text: mline draw_text.color: mcol draw_text.text_style.font_size: 12}
                        }
                    }
                }
            }
            }
        } else if vs.screen == G8_DECISION_RECORDED {
            ScrollYView{width: Fill height: Fill flow: Down spacing: 8
            View{width: Fill height: Fit flow: Down align: Align{x: 0.5}
                Image{width: 48 height: 48 fit: ImageFit.Smallest src: http_resource("{{assets}}/mascot_micro.png")}
            }
            let choice = "未知"
            let snap_cash = 0
            let snap_buf = 0
            if vs.last_decision != nil {
                choice = vs.last_decision.user_choice
                snap_cash = vs.last_decision.snapshot.cash
                snap_buf = vs.last_decision.snapshot.buffer_months
            }
            RoundedView{width: Fill height: Fit flow: Down padding: 18 spacing: 8 draw_bg.color: card_bg
                Label{text: "已记录决定：" + choice draw_text.color: leaf draw_text.text_style: theme.font_bold{font_size: 16}}
                Label{text: "决策时家庭：cash " + fmt_num(snap_cash) + " 元，buffer " + fmt_num(snap_buf) + " 月" draw_text.color: muted draw_text.text_style.font_size: 13}
                if vs.last_decision != nil {
                    Label{width: Fill text: "情景：" + g8_scenario_id_label(vs.last_decision.scenario_id) + " · 状态：" + vs.last_decision.policy_status draw_text.color: muted draw_text.text_style.font_size: 13}
                    Label{width: Fill text: "记录时间：" + vs.last_decision.created_at draw_text.color: muted draw_text.text_style.font_size: 12}
                }
                Label{text: "已记录决定数：" + vs.decision_count.to_string() draw_text.color: muted draw_text.text_style.font_size: 12}
            }
            ButtonFlat{text: "回到现在" height: 36 padding: Inset{left: 14 right: 14} on_click: || g8_on_click_now()
                draw_bg +: {border_radius: 18.0 color: leaf color_hover: leaf_dark border_size: 0.0}
                draw_text +: {color: #xffffff}}
            }
        } else if vs.screen == G8_CALC {
            ScrollYView{width: Fill height: Fill flow: Down spacing: 8
            let h = vs.household
            let nec = h.mortgage + h.living
            let buf = h.liquid_cash / nec
            let safety = h.safety_floor_months
            ButtonFlat{text: "← 回到现在" height: 36 padding: Inset{left: 14 right: 14} on_click: || g8_on_click_now()
                draw_bg +: {border_radius: 18.0 color: #ffffff color_hover: #xefede8 color_down: #xdcd7cf border_size: 1.0 border_color: leaf}
                draw_text +: {color: leaf}}
            ButtonFlat{text: "逐月现金流 →" height: 36 padding: Inset{left: 14 right: 14} on_click: || g8_on_click_flow()
                draw_bg +: {border_radius: 18.0 color: #ffffff color_hover: #xefede8 color_down: #xdcd7cf border_size: 1.0 border_color: leaf}
                draw_text +: {color: leaf}}
            RoundedView{width: Fill height: Fit flow: Down padding: 16 spacing: 6 draw_bg.color: card_bg
                Label{text: "数字怎么来的" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 16}}
                Label{width: Fill text: "每一步都可以按公式心算复核，全部由代码计算，没有任何数字来自猜测。" draw_text.color: muted draw_text.text_style.font_size: 12}
            }
            RoundedView{width: Fill height: Fit flow: Down padding: 16 spacing: 4 draw_bg.color: card_bg
                Label{text: "手算核对（示例数据 · 非生产结果）" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 13}}
                Label{width: Fill text: "用示例家庭（现金 80 万 / 月收入 4 万 / 必要月支出 2.7 万，净结余 1.3 万），三个数可以按公式心算：" draw_text.color: muted draw_text.text_style.font_size: 12}
                Label{width: Fill text: "当前现金覆盖：800000 ÷ 27000 ≈ 29.6 个月" draw_text.color: ink draw_text.text_style.font_size: 13}
                Label{width: Fill text: "第 18 个月基准期末：(800000 + 18 × 13000) ÷ 27000 ≈ 38.3 个月" draw_text.color: ink draw_text.text_style.font_size: 13}
                Label{width: Fill text: "第 18 个月事件期末：(800000 − 18 × 27000) ÷ 27000 ≈ 11.6 个月" draw_text.color: ink draw_text.text_style.font_size: 13}
                Label{width: Fill text: "12 个月安全底线与上面三个数同一口径（月）比较。" draw_text.color: muted draw_text.text_style.font_size: 12}
                if vs.simulation_result != nil && vs.scenario_summary != nil {
                    let srx = vs.simulation_result
                    let evx = ev_evidence(h, srx.horizon, ev_event_from_summary(vs.scenario_summary, h.monthly_income))
                    let pb = srx.baseline_path.buffer_at_horizon
                    let pe = srx.scenario_path.buffer_at_horizon
                    let mb = evx.base_horizon_coverage_months - pb
                    if mb < 0 { mb = 0 - mb }
                    let mev = evx.event_horizon_coverage_months - pe
                    if mev < 0 { mev = 0 - mev }
                    let vtxt = "手算与引擎一致（同一时点、同一口径）"
                    if mb > 0.05 || mev > 0.05 { vtxt = "本情景含期初偏移或额外假设，请以生产结果为准" }
                    Label{width: Fill text: "本屏该情景（第 " + fmt_num(srx.horizon) + " 个月期末）：基准 " + fmt_num(pb) + " 个月 ／ 事件后 " + fmt_num(pe) + " 个月" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 13}}
                    Label{width: Fill text: "手算核对：" + fmt_num(evx.base_horizon_coverage_months) + " ／ " + fmt_num(evx.event_horizon_coverage_months) + " 个月 —— " + vtxt draw_text.color: leaf draw_text.text_style.font_size: 12}
                }
                Label{width: Fill text: "这一块只是让人能上手复算；页面上的正式结果始终来自原有引擎。" draw_text.color: muted draw_text.text_style.font_size: 11}
            }
            RoundedView{width: Fill height: Fit flow: Down padding: 16 spacing: 4 draw_bg.color: card_bg
                Label{text: "第 1 步 · 家庭因子（来自家庭档案）" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 13}}
                Label{width: Fill text: "可动用现金 = " + fmt_yuan(h.liquid_cash) + " 元" draw_text.color: ink draw_text.text_style.font_size: 13}
                Label{width: Fill text: "房贷 = " + fmt_yuan(h.mortgage) + " 元/月 · 生活 = " + fmt_yuan(h.living) + " 元/月" draw_text.color: ink draw_text.text_style.font_size: 13}
                Label{width: Fill text: "收入 = " + fmt_yuan(h.monthly_income) + " 元/月 · 安全底线 = " + fmt_num(safety) + " 个月" draw_text.color: ink draw_text.text_style.font_size: 13}
            }
            RoundedView{width: Fill height: Fit flow: Down padding: 16 spacing: 4 draw_bg.color: card_bg
                Label{text: "第 2 步 · 必要月支出" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 13}}
                Label{width: Fill text: fmt_yuan(h.mortgage) + " + " + fmt_yuan(h.living) + " = " + fmt_yuan(nec) + " 元/月" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 15}}
            }
            RoundedView{width: Fill height: Fit flow: Down padding: 16 spacing: 4 draw_bg.color: card_bg
                Label{text: "第 3 步 · 安全余量" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 13}}
                Label{width: Fill text: fmt_yuan(h.liquid_cash) + " ÷ " + fmt_yuan(nec) + " = " + fmt_num(buf) + " 个月" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 15}}
                Label{width: Fill text: "底线判定：余量 < " + fmt_num(safety) + " 个月 = 跌破；差值不足 6 个月 = 接近" draw_text.color: muted draw_text.text_style.font_size: 12}
            }
            if vs.simulation_result != nil {
                let sr = vs.simulation_result
                let summary = vs.scenario_summary
                let delta_txt = "0 元/月"
                let one_txt = ""
                if summary != nil {
                    let dur = summary.duration_months
                    if summary.type == "REST" {
                        delta_txt = fmt_yuan(0 - nec) + " 元/月（收入为 0，持续 " + fmt_num(dur) + " 个月）"
                    }
                    if summary.type == "CAR_PURCHASE" {
                        one_txt = "期初一次性支出 " + fmt_yuan(summary.purchase_amount) + " 元"
                        delta_txt = "0 元/月"
                    }
                    if summary.type == "INCOME_CHANGE" {
                        delta_txt = fmt_yuan(summary.monthly_income_delta) + " 元/月（持续 " + fmt_num(dur) + " 个月）"
                    }
                    if summary.type == "EXPENSE_CHANGE" {
                        delta_txt = fmt_yuan(0 - summary.monthly_expense_delta) + " 元/月（持续 " + fmt_num(dur) + " 个月）"
                    }
                }
                let tr2 = try { sr.trace } { nil }
                let ci = 1
                if tr2 != nil {
                    for i in tr2.len() {
                        if i > 0 {
                            let rr = tr2[i]
                            if rr.scenario.income != rr.baseline.income || rr.scenario.one_time_expense != 0 || rr.scenario.expense_adjustment != 0 {
                                ci = i
                                break
                            }
                        }
                    }
                }
                let m = nil
                if tr2 != nil && tr2.len() > ci { m = tr2[ci].scenario }
                let mv = 1
                if m != nil {
                    if m.income > mv { mv = m.income }
                    if m.total_expense > mv { mv = m.total_expense }
                }
                let un2 = 110.0 / mv
                let w0 = m.opening_cash
                let w1 = w0 + m.income
                let w2 = w1 - m.mortgage_expense
                let w3 = w2 - m.living_expense
                let w4 = w3 - m.expense_adjustment
                let w5 = w4 - m.one_time_expense
                let wmax = w0
                let wmin = w0
                if w1 > wmax { wmax = w1 }
                if w2 > wmax { wmax = w2 }
                if w3 > wmax { wmax = w3 }
                if w4 > wmax { wmax = w4 }
                if w5 > wmax { wmax = w5 }
                if w1 < wmin { wmin = w1 }
                if w2 < wmin { wmin = w2 }
                if w3 < wmin { wmin = w3 }
                if w4 < wmin { wmin = w4 }
                if w5 < wmin { wmin = w5 }
                if wmin > 0 { wmin = 0 }
                let wu = 90.0 / (wmax - wmin + 1)
                RoundedView{width: Fill height: Fit flow: Down padding: 16 spacing: 4 draw_bg.color: card_bg
                    Label{text: "第 4 步 · 事件期一个月，钱从哪来到哪去" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 13}}
                    Label{width: Fill text: "事件期净现金流变化：" + delta_txt draw_text.color: ink draw_text.text_style.font_size: 13}
                    if one_txt != "" {
                        Label{width: Fill text: one_txt draw_text.color: ink draw_text.text_style.font_size: 13}
                    }
                    if m != nil {
                        View{width: Fill height: Fit flow: Right spacing: 12
                            View{width: Fill height: Fit flow: Down spacing: 2 align: Align{y: 1.0}
                                SolidView{width: Fill height: m.income * un2 draw_bg.color: leaf}
                                Label{width: Fill text: "收入 " + fmt_wan(m.income) draw_text.color: ink draw_text.text_style.font_size: 11}}
                            }
                            View{width: Fill height: Fit flow: Down spacing: 2 align: Align{y: 1.0}
                                SolidView{width: Fill height: m.living_expense * un2 draw_bg.color: muted}
                                SolidView{width: Fill height: m.mortgage_expense * un2 draw_bg.color: blue_c}
                                SolidView{width: Fill height: m.expense_adjustment * un2 draw_bg.color: warn_c}
                                SolidView{width: Fill height: m.one_time_expense * un2 draw_bg.color: danger_c}
                                Label{width: Fill text: "支出 " + fmt_wan(m.total_expense) draw_text.color: ink draw_text.text_style.font_size: 11}}
                            }
                        }
                        Label{text: "期初 " + fmt_wan(w0) + " 是怎么变成期末 " + fmt_wan(w5) + " 的" draw_text.color: leaf draw_text.text_style: theme.font_bold{font_size: 12}}
                        View{width: Fill height: Fit flow: Right spacing: 3 align: Align{y: 1.0}
                            View{width: Fill height: Fit flow: Down spacing: 1 align: Align{y: 1.0}
                                SolidView{width: Fill height: (w0 - wmin) * wu draw_bg.color: G8_C_BASE}
                                Label{width: Fill text: "期初" draw_text.color: muted draw_text.text_style.font_size: 9}
                                Label{width: Fill text: fmt_wan(w1 - w0) draw_text.color: ink draw_text.text_style.font_size: 9}}
                            View{width: Fill height: Fit flow: Down spacing: 1 align: Align{y: 1.0}
                                SolidView{width: Fill height: (w1 - wmin) * wu draw_bg.color: leaf}
                                Label{width: Fill text: "+收入" draw_text.color: muted draw_text.text_style.font_size: 9}
                                Label{width: Fill text: fmt_wan(w2 - w1) draw_text.color: ink draw_text.text_style.font_size: 9}}
                            View{width: Fill height: Fit flow: Down spacing: 1 align: Align{y: 1.0}
                                SolidView{width: Fill height: (w2 - wmin) * wu draw_bg.color: blue_c}
                                Label{width: Fill text: "-房贷" draw_text.color: muted draw_text.text_style.font_size: 9}
                                Label{width: Fill text: fmt_wan(w3 - w2) draw_text.color: ink draw_text.text_style.font_size: 9}}
                            View{width: Fill height: Fit flow: Down spacing: 1 align: Align{y: 1.0}
                                SolidView{width: Fill height: (w3 - wmin) * wu draw_bg.color: muted}
                                Label{width: Fill text: "-生活" draw_text.color: muted draw_text.text_style.font_size: 9}
                                Label{width: Fill text: fmt_wan(w4 - w3) draw_text.color: ink draw_text.text_style.font_size: 9}}
                            View{width: Fill height: Fit flow: Down spacing: 1 align: Align{y: 1.0}
                                SolidView{width: Fill height: (w4 - wmin) * wu draw_bg.color: warn_c}
                                Label{width: Fill text: "-其他" draw_text.color: muted draw_text.text_style.font_size: 9}
                                Label{width: Fill text: fmt_wan(w5 - w4) draw_text.color: ink draw_text.text_style.font_size: 9}}
                            View{width: Fill height: Fit flow: Down spacing: 1 align: Align{y: 1.0}
                                SolidView{width: Fill height: (w5 - wmin) * wu draw_bg.color: danger_c}
                                Label{width: Fill text: "-一次性" draw_text.color: muted draw_text.text_style.font_size: 9}
                                Label{width: Fill text: fmt_wan(w5 - w4) draw_text.color: ink draw_text.text_style.font_size: 9}}
                            View{width: Fill height: Fit flow: Down spacing: 1 align: Align{y: 1.0}
                                SolidView{width: Fill height: (w5 - wmin) * wu draw_bg.color: leaf}
                                Label{width: Fill text: "期末" draw_text.color: muted draw_text.text_style.font_size: 9}
                                Label{width: Fill text: fmt_wan(w5 - w0) draw_text.color: ink draw_text.text_style.font_size: 9}}
                        }
                        Label{width: Fill text: "净变化 " + fmt_wan(m.net_change) + "｜期末现金 " + fmt_wan(m.ending_cash) draw_text.color: ink draw_text.text_style.font_size: 13}
                        if m.net_change < 0 {
                            Label{width: Fill text: "当月收入不够支出，缺口由可用现金垫补足。" draw_text.color: warn_c draw_text.text_style.font_size: 12}
                        }
                        if m.ending_cash < 0 {
                            Label{width: Fill text: "现金垫已耗尽，这个月出现无垫缺口。" draw_text.color: danger_c draw_text.text_style.font_size: 12}
                        }
                    }
                    Label{width: Fill text: "推演期末比较：基准（不发生）" + fmt_num(sr.baseline_path.buffer_at_horizon) + " 个月 → 事件后 " + fmt_num(sr.scenario_path.buffer_at_horizon) + " 个月" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 13}}
                    Label{width: Fill text: "期间最低点：" + fmt_num(sr.scenario_path.minimum_buffer) + " 个月" draw_text.color: muted draw_text.text_style.font_size: 12}
                    if sr.scenario_path.breach_month == nil {
                        Label{width: Fill text: "全程未跌破底线" draw_text.color: margin_c draw_text.text_style.font_size: 13}
                    } else {
                        Label{width: Fill text: "首次跌破底线：第 " + fmt_num(sr.scenario_path.breach_month) + " 个月" draw_text.color: danger_c draw_text.text_style: theme.font_bold{font_size: 13}}
                    }
                }
            }
            RoundedView{width: Fill height: Fit flow: Down padding: 12 spacing: 2 draw_bg.color: paper
                Label{width: Fill text: "兜兜不替你做决定，只把这些算给你看。" draw_text.color: muted draw_text.text_style.font_size: 12}
            }
            }
        }
    }}
}
