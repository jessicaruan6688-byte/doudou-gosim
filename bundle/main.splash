// =====================================================================
// End of G2
// =====================================================================

// =====================================================================
// G3 — Simulation (Final Patch, frozen)
// Pure deterministic simulate(household, scenario) -> SimulationResult.
// Baseline and scenario share initial state and horizon. For duration=0
// (permanent / one-shot), trajectory extends to start_month+1 so the
// effect is captured. policy_status is placeholder "pending"; G4 will
// classify. No policy logic. No parser. No UI. No I/O.
// =====================================================================

fn g3_demo_household() {
    return domain_HouseholdState({
        schema_version: 2,
        household_id: "h_demo",
        created_at: "2026-10-05T00:00:00Z",
        updated_at: "2026-10-05T00:00:00Z",
        monthly_income: 40000,
        mortgage: 15000,
        living: 12000,
        liquid_cash: 800000,
        safety_floor_months: 12
    })
}

// Returns the FULL monthly net cash flow that applies while the scenario is
// in effect, not the change amount: REST zeroes income but keeps necessary
// expense; INCOME_CHANGE / EXPENSE_CHANGE are layered on top of the baseline
// net flow (income - necessary); anything else keeps the baseline flow. The
// one-time purchase is never folded in here; it stays a separate one-time
// deduction.
fn g3_scenario_cf_per_month(type, monthly_income_delta, monthly_expense_delta, monthly_income, necessary) {
    let baseline_cf = monthly_income - necessary

    if type == "REST" {
        return 0 - necessary
    }
    if type == "INCOME_CHANGE" {
        return baseline_cf + monthly_income_delta
    }
    if type == "EXPENSE_CHANGE" {
        return baseline_cf - monthly_expense_delta
    }

    return baseline_cf
}

fn g3_scenario_one_time(type, purchase_amount) {
    if type == "CAR_PURCHASE" { return 0 - purchase_amount }
    return 0
}

// trace_ctx carries what the trajectory needs beyond the cash math: the
// expense split (mortgage / living) plus, for the scenario path only, the
// scenario type and its signed deltas. Cash arithmetic is unchanged: cash
// still advances by cf + ot, and every trace field is recorded from the same
// step, never derived back from the horizon summary.
fn g3_simulate_path(initial_cash, monthly_income, necessary, safety_floor, start_month, duration, horizon, scenario_cf, one_time_at_start, apply_scenario, trace_ctx) {
    let baseline_cf = monthly_income - necessary
    let cash = initial_cash
    let initial_buffer = cash / necessary
    let minimum_cash = cash
    let minimum_buffer = initial_buffer
    let breach_month = nil
    if initial_buffer < safety_floor { breach_month = 0 }

    let scenario_end = start_month + duration

    let mortgage = 0
    let living = necessary
    let s_type = ""
    let income_delta = 0
    let expense_delta = 0
    if trace_ctx != nil {
        mortgage = trace_ctx.mortgage
        living = trace_ctx.living
        s_type = trace_ctx.scenario_type
        income_delta = trace_ctx.income_delta
        expense_delta = trace_ctx.expense_delta
    }

    let trace = []
    trace.push({ period_index: 0, opening_cash: initial_cash, income: 0, mortgage_expense: 0, living_expense: 0, expense_adjustment: 0, one_time_expense: 0, total_expense: 0, net_change: 0, ending_cash: initial_cash, buffer_months: initial_buffer })

    for t in horizon {
        let cf = baseline_cf
        let ot = 0
        let in_scenario = 0
        if apply_scenario == 1 {
            if duration == 0 {
                if t == start_month {
                    cf = scenario_cf
                    ot = one_time_at_start
                    in_scenario = 1
                }
            } else {
                if t >= start_month && t < scenario_end {
                    cf = scenario_cf
                    if t == start_month { ot = one_time_at_start }
                    in_scenario = 1
                }
            }
        }

        let opening_cash = cash
        let income = monthly_income
        let expense_adjustment = 0
        if in_scenario == 1 {
            if s_type == "REST" { income = 0 }
            if s_type == "INCOME_CHANGE" { income = monthly_income + income_delta }
            if s_type == "EXPENSE_CHANGE" { expense_adjustment = expense_delta }
        }
        let one_time_expense = 0 - ot
        let total_expense = mortgage + living + expense_adjustment + one_time_expense

        cash = cash + cf + ot
        if cash < minimum_cash { minimum_cash = cash }
        let buffer = cash / necessary
        if buffer < minimum_buffer { minimum_buffer = buffer }
        if buffer < safety_floor && breach_month == nil {
            breach_month = t + 1
        }

        trace.push({ period_index: t + 1, opening_cash: opening_cash, income: income, mortgage_expense: mortgage, living_expense: living, expense_adjustment: expense_adjustment, one_time_expense: one_time_expense, total_expense: total_expense, net_change: cf + ot, ending_cash: cash, buffer_months: buffer })
    }

    return {
        cash_at_horizon: cash,
        buffer_at_horizon: cash / necessary,
        minimum_cash: minimum_cash,
        minimum_buffer: minimum_buffer,
        breach_month: breach_month,
        policy_status: "pending",
        trace: trace
    }
}

fn g3_simulate(household, scenario) {
    let necessary = household.mortgage + household.living
    if necessary <= 0 {
        return { kind: "Error", reason: "necessary_expense must be > 0" }
    }
    let monthly_income = household.monthly_income
    let liquid_cash = household.liquid_cash
    let safety_floor = household.safety_floor_months

    let start_month = scenario.start_month
    let duration = scenario.duration_months
    let user_horizon = start_month + duration
    let effective_horizon = user_horizon
    if effective_horizon < start_month + 1 { effective_horizon = start_month + 1 }

    let scenario_cf = g3_scenario_cf_per_month(scenario.type, scenario.monthly_income_delta, scenario.monthly_expense_delta, monthly_income, necessary)
    let one_time = g3_scenario_one_time(scenario.type, scenario.purchase_amount)

    let income_delta = scenario.monthly_income_delta
    if income_delta == nil { income_delta = 0 }
    let expense_delta = scenario.monthly_expense_delta
    if expense_delta == nil { expense_delta = 0 }

    let baseline_ctx = {
        scenario_type: "",
        income_delta: 0,
        expense_delta: 0,
        mortgage: household.mortgage,
        living: household.living
    }

    let scenario_ctx = {
        scenario_type: scenario.type,
        income_delta: income_delta,
        expense_delta: expense_delta,
        mortgage: household.mortgage,
        living: household.living
    }

    let baseline_path = g3_simulate_path(
        liquid_cash, monthly_income, necessary, safety_floor,
        start_month, duration, effective_horizon,
        0, 0, 0, baseline_ctx
    )

    let scenario_path = g3_simulate_path(
        liquid_cash, monthly_income, necessary, safety_floor,
        start_month, duration, effective_horizon,
        scenario_cf, one_time, 1, scenario_ctx
    )

    // Pair the two trajectories by period index: both paths run the same
    // horizon, so they always have the same length (horizon + 1).
    let trace = []
    let baseline_trace = baseline_path.trace
    let scenario_trace = scenario_path.trace
    for i in baseline_trace.len() {
        trace.push({ period_index: i, baseline: baseline_trace[i], scenario: scenario_trace[i] })
    }

    let delta = {
        cash_delta: scenario_path.cash_at_horizon - baseline_path.cash_at_horizon,
        buffer_delta: scenario_path.buffer_at_horizon - baseline_path.buffer_at_horizon,
        minimum_cash_delta: scenario_path.minimum_cash - baseline_path.minimum_cash,
        minimum_buffer_delta: scenario_path.minimum_buffer - baseline_path.minimum_buffer
    }

    return {
        kind: "SimulationResult",
        scenario_id: scenario.scenario_id,
        horizon: effective_horizon,
        baseline_path: baseline_path,
        scenario_path: scenario_path,
        delta: delta,
        trace: trace
    }
}

fn g3_test_baseline_only_zero_effect() {
    let h = g3_demo_household()
    let s = g2_INCOME_CHANGE({
        scenario_id: "s",
        monthly_income_delta: 0,
        duration_months: 6,
        created_at: "t"
    })
    let r = g3_simulate(h, s)
    if r.kind != "SimulationResult" { return { success: false, error: "simulate failed" } }
    if r.delta.cash_delta != 0 { return { success: false, error: "expected zero delta", got: r.delta.cash_delta } }
    return { success: true }
}

