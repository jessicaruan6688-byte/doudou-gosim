    let r = g5_parse("想辞职半年", nil)
    if r.kind != "ParsedIntent" { return { success: false, error: "expected ParsedIntent", got: r } }
    if r.intent_type != "REST" { return { success: false, error: "intent_type wrong" } }
    if r.duration_months != 6 { return { success: false, error: "duration wrong", got: r.duration_months } }
    return { success: true }
}

