        policy_status: "danger"
    })
    if !r.success { return { success: false, error: "record failed" } }
    if r.record.user_choice != "defer" { return { success: false, error: "choice wrong" } }
    return { success: true }
}

fn g7_test_time_ordering() {
    g7_clear()
    g7_record({ scenario_id: "sc_a", user_choice: "accept", snapshot: { cash: 100, buffer_months: 10 }, policy_status: "ok" })
    g7_record({ scenario_id: "sc_b", user_choice: "decline", snapshot: { cash: 200, buffer_months: 20 }, policy_status: "ok" })
    g7_record({ scenario_id: "sc_c", user_choice: "defer", snapshot: { cash: 300, buffer_months: 30 }, policy_status: "ok" })
    let recent = g7_recent(3)
    if recent.len() != 3 { return { success: false, error: "size wrong" } }
    if recent[0].scenario_id != "sc_a" { return { success: false, error: "first record not oldest" } }
    if recent[1].scenario_id != "sc_b" { return { success: false, error: "second record wrong" } }
    if recent[2].scenario_id != "sc_c" { return { success: false, error: "third record wrong" } }
    return { success: true }
}

fn g7_test_cap_32() {
    g7_clear()
    let i = 0
    while i < 32 {
        g7_record({
            scenario_id: "sc_" + i.to_string(),
            user_choice: "accept",
            snapshot: { cash: 100, buffer_months: 10 },
            policy_status: "ok"
        })
        i = i + 1
    }
    if g7_size() != 32 { return { success: false, error: "size should be 32", got: g7_size() } }
    return { success: true }
}

fn g7_test_evict_on_33rd() {
    g7_clear()
    let i = 0
    while i < 33 {
        g7_record({
            scenario_id: "sc_" + i.to_string(),
            user_choice: "accept",
            snapshot: { cash: 100, buffer_months: 10 },
            policy_status: "ok"
        })
        i = i + 1
    }
    if g7_size() != 32 { return { success: false, error: "size should remain 32", got: g7_size() } }
    let recent = g7_recent(32)
    if recent[0].scenario_id != "sc_1" { return { success: false, error: "oldest (sc_0) should be evicted; first is " + recent[0].scenario_id } }
    if recent[31].scenario_id != "sc_32" { return { success: false, error: "newest should be sc_32" } }
    return { success: true }
}

fn g7_test_no_chat_text() {
    g7_clear()
    let r = g7_record({
        scenario_id: "sc1",
        user_choice: "decline",
        reason: "user said 'maybe later'",  // plain string, not chat log
        snapshot: { cash: 800000, buffer_months: 29.6 },
        policy_status: "ok"
    })
    if !r.success { return { success: false, error: "record failed" } }
    // reason field is the user-supplied reason string; record has no chat log field
    let rec = r.record
    if rec.scenario_id == nil { return { success: false, error: "no scenario_id" } }
    // No "raw_text" or "chat_log" field
    return { success: true }
}

