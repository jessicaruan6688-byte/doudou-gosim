// =====================================================================
// G2 — Scenario (Final Patch, frozen)
// Type-specific Scenario constructors and defaults. Per-type required
// fields enforced (already covered by G0 domain_Scenario). start_month
// defaults to 0; per-type duration semantics enforced. No cash math,
// no buffer math, no policy, no parser, no UI, no I/O.
// =====================================================================

fn g2_default_start_month(args) {
    if args.start_month == nil { return 0 }
    return args.start_month
}

fn g2_REST(args) {
    let merged = {
        scenario_id: args.scenario_id,
        type: "REST",
        start_month: g2_default_start_month(args),
        duration_months: args.duration_months,
        created_at: args.created_at,
        description: args.description,
        purchase_amount: nil,
        monthly_income_delta: nil,
        monthly_expense_delta: nil
    }
    return domain_Scenario(merged)
}

fn g2_CAR_PURCHASE(args) {
    let merged = {
        scenario_id: args.scenario_id,
        type: "CAR_PURCHASE",
        start_month: g2_default_start_month(args),
        duration_months: 0,
        created_at: args.created_at,
        description: args.description,
        purchase_amount: args.purchase_amount,
        monthly_income_delta: nil,
        monthly_expense_delta: nil
    }
    return domain_Scenario(merged)
}

fn g2_INCOME_CHANGE(args) {
    let merged = {
        scenario_id: args.scenario_id,
        type: "INCOME_CHANGE",
        start_month: g2_default_start_month(args),
        duration_months: args.duration_months,
        created_at: args.created_at,
        description: args.description,
        purchase_amount: nil,
        monthly_income_delta: args.monthly_income_delta,
        monthly_expense_delta: nil
    }
    return domain_Scenario(merged)
}

fn g2_EXPENSE_CHANGE(args) {
    let merged = {
        scenario_id: args.scenario_id,
        type: "EXPENSE_CHANGE",
        start_month: g2_default_start_month(args),
        duration_months: args.duration_months,
        created_at: args.created_at,
        description: args.description,
        purchase_amount: nil,
        monthly_income_delta: nil,
        monthly_expense_delta: args.monthly_expense_delta
    }
    return domain_Scenario(merged)
}

fn g2_scenario_type_required_fields(type) {
    if type == "REST" { return [] }
    if type == "CAR_PURCHASE" { return ["purchase_amount"] }
    if type == "INCOME_CHANGE" { return ["monthly_income_delta"] }
    if type == "EXPENSE_CHANGE" { return ["monthly_expense_delta"] }
    return []
}

fn g2_scenario_type_field_constraints(type) {
    if type == "REST" { return ["duration_months_must_be_positive"] }
    if type == "CAR_PURCHASE" { return ["purchase_amount_must_be_non_negative"] }
    if type == "INCOME_CHANGE" { return ["duration_months_must_be_non_negative", "monthly_expense_delta_forbidden"] }
    if type == "EXPENSE_CHANGE" { return ["duration_months_must_be_non_negative", "monthly_income_delta_forbidden"] }
    return []
}

fn g2_scenario_default_duration_for_type(type) {
    if type == "CAR_PURCHASE" { return 0 }
    return 0
}

fn g2_test_rest_ok() {
    let s = g2_REST({
        scenario_id: "sc_rest_ok",
        duration_months: 6,
        created_at: "2026-10-05T00:00:00Z"
    })
    if s.kind != "Scenario" { return { success: false, error: "REST ok failed", got: s } }
    if s.type != "REST" { return { success: false, error: "type wrong" } }
    if s.duration_months != 6 { return { success: false, error: "duration wrong" } }
    if s.start_month != 0 { return { success: false, error: "start_month default failed" } }
    return { success: true }
}

fn g2_test_rest_invalid_duration_zero() {
    let s = g2_REST({
        scenario_id: "sc_rest_invalid",
        duration_months: 0,
        created_at: "2026-10-05T00:00:00Z"
    })
    if s.kind != "ValidationError" { return { success: false, error: "REST duration=0 should fail" } }
    return { success: true }
}

fn g2_test_car_purchase_ok() {
    let s = g2_CAR_PURCHASE({
        scenario_id: "sc_car_ok",
        purchase_amount: 300000,
        created_at: "2026-10-05T00:00:00Z"
    })
    if s.kind != "Scenario" { return { success: false, error: "CAR_PURCHASE ok failed", got: s } }
    if s.type != "CAR_PURCHASE" { return { success: false, error: "type wrong" } }
    if s.purchase_amount != 300000 { return { success: false, error: "purchase_amount wrong" } }
    if s.duration_months != 0 { return { success: false, error: "default duration wrong" } }
    return { success: true }
}

fn g2_test_car_purchase_negative() {
    let s = g2_CAR_PURCHASE({
        scenario_id: "sc_car_neg",
        purchase_amount: -100,
        created_at: "2026-10-05T00:00:00Z"
    })
    if s.kind != "ValidationError" { return { success: false, error: "CAR_PURCHASE negative should fail" } }
    return { success: true }
}

fn g2_test_income_change_ok() {
    let s = g2_INCOME_CHANGE({
