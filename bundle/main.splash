fn g7_test_does_not_replace_household_state() {
    // Decision memory is separate from HouseholdState — both can coexist
    g7_clear()
    let h = g3_demo_household()
    let before_snapshot = h.liquid_cash
    g7_record({
        scenario_id: "sc1",
        user_choice: "accept",
        snapshot: { cash: 999999, buffer_months: 99.9 },
        policy_status: "ok"
    })
    if h.liquid_cash != before_snapshot { return { success: false, error: "decision record must not affect HouseholdState" } }
    return { success: true }
}

// =====================================================================
// End of G7
// =====================================================================

// =====================================================================
// G8 — Integration (Final Patch, frozen)
// UI submit → flow_submit_text → G5 → G6 → G3 → G4 → view_state → render
// flow_decide → G7 → G1. UI/render never compute cash/buffer/policy
// directly. State machine: IDLE / NEED_CLARIFICATION / PARSE_FAILURE /
// VALIDATION_FAILURE / RESULT / DECISION_RECORDED / CALC.
// CALC is a read-only derivation page: it re-displays the engine's inputs
// and formulas so a reviewer can verify results by hand. It never feeds
// the simulation pipeline.
// =====================================================================

let G8_IDLE = "IDLE"
let G8_NEED_CLARIFICATION = "NEED_CLARIFICATION"
let G8_PARSE_FAILURE = "PARSE_FAILURE"
let G8_VALIDATION_FAILURE = "VALIDATION_FAILURE"
let G8_RESULT = "RESULT"
let G8_DECISION_RECORDED = "DECISION_RECORDED"
let G8_CALC = "CALC"
let G8_FLOW = "FLOW"
let G8_ONBOARD = "ONBOARD"
// P0 — custom-event editor. A person can build an event by hand (no AI, no
// network) and still land on the existing deterministic engine.
let G8_EVENT_DRAFT = "EVENT_DRAFT"

let g8_view_state = {
    screen: G8_IDLE,
    input_text: "",
    parse_status: nil,
    clarification: nil,
    validation_error: nil,
    scenario_summary: nil,
    simulation_result: nil,
    policy_status_baseline: nil,
    policy_status_scenario: nil,
    decision_count: 0,
    last_decision: nil,
    migration_notice: nil,
    persistence_status: nil,
    household: nil,
    last_scenario_id: nil,
    last_scenario_cash_at_horizon: nil,
    last_scenario_buffer_at_horizon: nil,
    recent_decisions: [],
    onboard_step: nil,
    onboard_error: nil,
    onboard_data: nil,
    ev_draft: nil,
    ev_error: nil,
    ev_note: nil,
    ev_confirmed_event: nil,
    ev_ai_status: nil,
    ev_ai_message: nil,
    household_is_demo: false,
    selected_month: 0
}

fn g8_clone_state(state) {
    return {
        screen: state.screen,
        input_text: state.input_text,
        parse_status: state.parse_status,
        clarification: state.clarification,
        validation_error: state.validation_error,
        scenario_summary: state.scenario_summary,
        simulation_result: state.simulation_result,
        policy_status_baseline: state.policy_status_baseline,
        policy_status_scenario: state.policy_status_scenario,
        decision_count: state.decision_count,
        last_decision: state.last_decision,
        migration_notice: state.migration_notice,
        persistence_status: state.persistence_status,
        household: state.household,
        last_scenario_id: state.last_scenario_id,
        last_scenario_cash_at_horizon: state.last_scenario_cash_at_horizon,
        last_scenario_buffer_at_horizon: state.last_scenario_buffer_at_horizon,
        recent_decisions: state.recent_decisions,
        onboard_step: state.onboard_step,
        onboard_error: state.onboard_error,
        onboard_data: state.onboard_data,
        household_is_demo: state.household_is_demo,
        selected_month: state.selected_month,
        ev_draft: state.ev_draft,
        ev_error: state.ev_error,
        ev_note: state.ev_note,
        ev_confirmed_event: state.ev_confirmed_event,
        ev_ai_status: state.ev_ai_status,
        ev_ai_message: state.ev_ai_message
    }
}

fn g8_default_policy(household) {
    return domain_SafetyPolicy({
        minimum_buffer_months: household.safety_floor_months,
        minimum_cash_after_event: 0,
        warn_buffer_threshold: household.safety_floor_months
    })
}

// =====================================================================
// P0 — custom household event + hand-calculation evidence.
//
// Mirrors the reviewed Node contracts:
//   src/domain/household-event.mjs
//   src/domain/cash-runway-evidence.mjs
//
// BOUNDARY: this block does NOT replace g3/g4 and adds no formula. A confirmed
// event is mapped onto the EXISTING chain
//     domain_ParsedIntent -> g6_validate -> flow_run_scenario_to_result -> g3/g4
// so the numbers on the RESULT page still come from the production engine.
// The evidence block is a separately-labelled hand-check, never a result source.
// =====================================================================

let EV_TYPES = ["income_loss" "income_change" "purchase" "medical_cost" "education_cost" "caregiving" "other"]
let EV_MAX_AMOUNT = 100000000.0
let EV_MAX_MONTHS = 600

fn ev_type_known(t) {
    if t == nil { return false }
    for v in EV_TYPES {
        if v == t { return true }
    }
    return false
}

fn ev_type_label(t) {
    if t == "income_loss" { return "收入中断" }
    if t == "income_change" { return "收入变化" }
    if t == "purchase" { return "一次性购买" }
    if t == "medical_cost" { return "医疗支出" }
    if t == "education_cost" { return "教育支出" }
    if t == "caregiving" { return "照护支出" }
    return "其他"
}

fn ev_empty_draft() {
    return {
        title: "",
        event_type: "income_loss",
        monthly_income_delta: nil,
        monthly_expense_delta: nil,
        one_time_cash_delta: nil,
        duration_months: nil,
        source: "manual"
    }
}

fn ev_amount_ok(v) {
    if v == nil { return true }
    if v != v { return false }
    if abs(v) > EV_MAX_AMOUNT { return false }
    return true
}

// Same rules as validateHouseholdEvent() in src/domain/household-event.mjs.
fn ev_validate(draft) {
    let errs = []
    if draft == nil { return ["事件格式不正确"] }
    if draft.title == nil || draft.title.trim() == "" { errs.push("请填写事件名称") }
    if !ev_type_known(draft.event_type) { errs.push("事件类型不受支持") }
    if draft.duration_months == nil { errs.push("请填写持续月数（一次性事件填 0）") }
    if draft.duration_months != nil {
        if draft.duration_months < 0 || draft.duration_months > EV_MAX_MONTHS { errs.push("持续月数须为 0–600") }
        if draft.duration_months != floor(draft.duration_months) { errs.push("持续月数须为整数") }
    }
    if !ev_amount_ok(draft.monthly_income_delta) { errs.push("每月收入变化金额超出范围") }
    if !ev_amount_ok(draft.monthly_expense_delta) { errs.push("每月支出变化金额超出范围") }
    if !ev_amount_ok(draft.one_time_cash_delta) { errs.push("一次性现金变化金额超出范围") }
    let has_amt = false
    if draft.monthly_income_delta != nil && draft.monthly_income_delta != 0 { has_amt = true }
    if draft.monthly_expense_delta != nil && draft.monthly_expense_delta != 0 { has_amt = true }
    if draft.one_time_cash_delta != nil && draft.one_time_cash_delta != 0 { has_amt = true }
    if !has_amt { errs.push("请至少填写一项非零金额") }
    if draft.event_type == "purchase" && draft.one_time_cash_delta == nil && draft.monthly_expense_delta == nil {
        errs.push("购买事件需要填写一次性支出或新增月支出")
    }
    return errs
}

// Confirmation gate. Nothing reaches the engine before this passes.
fn ev_confirm(draft) {
    let errs = ev_validate(draft)
    if errs.len() > 0 {
        return { passed: false, errors: errs, event: nil }
    }
    let src = "manual"
    if draft.source == "ai" { src = "ai_confirmed" }
    let e = {
        title: draft.title.trim(),
        event_type: draft.event_type,
        monthly_income_delta: draft.monthly_income_delta,
        monthly_expense_delta: draft.monthly_expense_delta,
        one_time_cash_delta: draft.one_time_cash_delta,
        duration_months: draft.duration_months,
        source: src,
        confirmed: true
    }
    return { passed: true, errors: [], event: e }
}

// Mapping table: 7 event types -> the engine's 4 scenario types.
// Identical rules to toScenarioDraft() in src/domain/household-event.mjs.
fn ev_map(event) {
    if event == nil { return { passed: false, reason: "事件尚未确认", intent: nil, note: "" } }
    if event.confirmed != true { return { passed: false, reason: "事件尚未确认", intent: nil, note: "" } }
    let inc = event.monthly_income_delta
    let exp = event.monthly_expense_delta
    let one = event.one_time_cash_delta
    let dur = event.duration_months
    let inc_nz = inc != nil && inc != 0
    let exp_nz = exp != nil && exp != 0
    let one_nz = one != nil && one != 0

    if one_nz && !exp_nz && !inc_nz {
        let intent = domain_ParsedIntent({
            intent_type: "CAR_PURCHASE", start_month: 0, duration_months: 0,
            purchase_amount: abs(one), monthly_income_delta: nil, monthly_expense_delta: nil,
            ambiguous_fields: []
        })
        return { passed: true, reason: "", intent: intent, note: "一次性现金流出 → 引擎 CAR_PURCHASE（期初一次性扣减）" }
    }
    if exp_nz && !inc_nz {
        let intent = domain_ParsedIntent({
            intent_type: "EXPENSE_CHANGE", start_month: 0, duration_months: dur,
            purchase_amount: nil, monthly_income_delta: nil, monthly_expense_delta: abs(exp),
            ambiguous_fields: []
        })
        return { passed: true, reason: "", intent: intent, note: "每月支出变化 → 引擎 EXPENSE_CHANGE" }
    }
    if inc_nz {
        if event.event_type == "income_loss" {
            if dur == nil || dur <= 0 {
                return { passed: false, reason: "收入中断需要填写大于 0 的持续月数", intent: nil, note: "" }
            }
            let intent = domain_ParsedIntent({
                intent_type: "REST", start_month: 0, duration_months: dur,
                purchase_amount: nil, monthly_income_delta: nil, monthly_expense_delta: nil,
                ambiguous_fields: []
            })
            return { passed: true, reason: "", intent: intent, note: "收入中断 → 引擎 REST（该期间收入为 0）" }
        }
        let intent = domain_ParsedIntent({
            intent_type: "INCOME_CHANGE", start_month: 0, duration_months: dur,
            purchase_amount: nil, monthly_income_delta: inc, monthly_expense_delta: nil,
            ambiguous_fields: []
        })
        return { passed: true, reason: "", intent: intent, note: "每月收入变化 → 引擎 INCOME_CHANGE" }
    }
    return { passed: false, reason: "没有任何可映射的金额", intent: nil, note: "" }
}

// Consume the proxy's `event` object (the JSON the reviewed AI client returns).
// This is the in-app wiring point for the model path. It parses and validates;
// it never invents a value and never claims a call succeeded.
fn ev_from_ai_json(text) {
    if text == nil || text.trim() == "" {
        return { passed: false, error: "输入框是空的：请把 AI 返回的事件 JSON 粘进来", draft: nil }
    }
    let parsed = text.trim().parse_json()
    if parsed == nil {
        return { passed: false, error: "这段内容不是合法 JSON", draft: nil }
    }
    let t = try { parsed.eventType } { nil }
    if !ev_type_known(t) {
        return { passed: false, error: "AI 返回的事件类型不受支持（需要 7 类之一）", draft: nil }
    }
    let title = try { parsed.title } { nil }
    if title == nil || title == "" { title = "AI 事件" }
    let d = ev_empty_draft()
    d.title = title
    d.event_type = t
    d.monthly_income_delta = try { parsed.monthlyIncomeDelta } { nil }
    d.monthly_expense_delta = try { parsed.monthlyExpenseDelta } { nil }
    d.one_time_cash_delta = try { parsed.oneTimeCashDelta } { nil }
    d.duration_months = try { parsed.durationMonths } { nil }
    d.source = "ai"
    return { passed: true, error: "", draft: d }
}

// The honest AI availability check. Reflects the real platform state:
// `model.complete` is a draft service (every call answers "no service answers
// model on this device") and this manifest is granted only `storage`.
fn ev_ai_probe() {
    let granted_model = try { host.has("model") } { false }
    let granted_net = try { host.has("net") } { false }
    if granted_model {
        return { available: true, message: "已获授 model 能力；本机是否真有 model 服务，以实际调用结果为准。" }
    }
    if granted_net {
        return { available: true, message: "已获授 net 能力；仍需 manifest 声明公网 HTTPS 主机后才能真正请求。" }
    }
    return { available: false, message: "当前不可用：本机没有 model 服务（平台该能力尚未发布），应用也未获授 net 权限（manifest 仅 storage）。请改用下方手动输入，或在服务端部署代理并单独授权。" }
}

fn ev_round1(v) {
    return round(v * 10.0) / 10.0
}

// Hand-check evidence. Same arithmetic as calculateCashRunwayEvidence().
// Always a demo/verification aid; production numbers come from g3/g4.
fn ev_evidence(hh, horizon, event) {
    let nec = hh.mortgage + hh.living
    let income = hh.monthly_income
    let cash = hh.liquid_cash
    let base_net = income - nec
    let inc_d = 0
    let exp_d = 0
    let one_d = 0
    let dur = 0
    if event != nil {
        if event.monthly_income_delta != nil { inc_d = event.monthly_income_delta }
        if event.monthly_expense_delta != nil { exp_d = event.monthly_expense_delta }
        if event.one_time_cash_delta != nil { one_d = event.one_time_cash_delta }
        if event.duration_months != nil { dur = event.duration_months }
    }
    let active = dur
    if active > horizon { active = horizon }
    let ev_net = inc_d - exp_d
    let base_cash = cash + horizon * base_net
    let ev_cash = cash + horizon * base_net + active * ev_net + one_d
    return {
        necessary: nec,
        horizon_months: horizon,
        base_monthly_net: base_net,
        event_monthly_net: ev_net,
        active_months: active,
        base_cash_at_horizon: base_cash,
        event_cash_at_horizon: ev_cash,
        current_coverage_months: ev_round1(cash / nec),
        base_horizon_coverage_months: ev_round1(base_cash / nec),
        event_horizon_coverage_months: ev_round1(ev_cash / nec)
    }
}

// Build an event-shaped view of the scenario that is on screen, so the
// evidence arithmetic can be compared with the engine's own output. Only used
// for the hand-check label; it never feeds a result.
fn ev_event_from_summary(summary, income) {
    if summary == nil { return nil }
    let e = { monthly_income_delta: 0, monthly_expense_delta: 0, one_time_cash_delta: 0, duration_months: 0 }
    if summary.duration_months != nil { e.duration_months = summary.duration_months }
    if summary.type == "REST" { e.monthly_income_delta = 0 - income }
    if summary.type == "INCOME_CHANGE" {
        if summary.monthly_income_delta != nil { e.monthly_income_delta = summary.monthly_income_delta }
    }
    if summary.type == "EXPENSE_CHANGE" {
        if summary.monthly_expense_delta != nil { e.monthly_expense_delta = summary.monthly_expense_delta }
    }
    if summary.type == "CAR_PURCHASE" {
        if summary.purchase_amount != nil { e.one_time_cash_delta = 0 - summary.purchase_amount }
    }
    return e
}

// ----- handlers -----

fn g8_on_click_ev_start() {
    let state = g8_clone_state(g8_view_state)
    state.screen = G8_EVENT_DRAFT
    if state.ev_draft == nil { state.ev_draft = ev_empty_draft() }
    state.ev_error = nil
    state.ev_note = nil
    g8_view_state = state
    ui.board.render()
}

fn g8_on_click_ev_type(t) {
    let state = g8_clone_state(g8_view_state)
    if state.ev_draft == nil { state.ev_draft = ev_empty_draft() }
    state.ev_draft.event_type = t
    state.ev_error = nil
    g8_view_state = state
    ui.board.render()
}

fn g8_on_click_ev_set(field) {
    let state = g8_clone_state(g8_view_state)
    if state.ev_draft == nil { state.ev_draft = ev_empty_draft() }
    let raw = ui.entry.text().trim()
    if raw == "" {
        state.ev_error = "请先在顶部输入框填一个数字，再点这个按钮"
        g8_view_state = state
        ui.board.render()
        return
    }
    if field == "title" {
        state.ev_draft.title = raw
        state.ev_error = nil
        ui.entry.set_text("")
        g8_view_state = state
        ui.board.render()
        return
    }
    let v = raw.to_f64()
    if v != v {
        state.ev_error = "没看懂这个数字，请只填数字（元 / 月），负数前面加 -"
        g8_view_state = state
        ui.board.render()
        return
    }
    if field == "income" { state.ev_draft.monthly_income_delta = v }
    if field == "expense" { state.ev_draft.monthly_expense_delta = v }
    if field == "one" { state.ev_draft.one_time_cash_delta = v }
    if field == "duration" { state.ev_draft.duration_months = v }
    state.ev_error = nil
    ui.entry.set_text("")
    g8_view_state = state
    ui.board.render()
}

// Confirm -> map -> the EXISTING validator and engine. No new math here.
fn g8_on_click_ev_confirm() {
    let state = g8_clone_state(g8_view_state)
    if state.ev_draft == nil { state.ev_draft = ev_empty_draft() }
    let c = ev_confirm(state.ev_draft)
    if !c.passed {
        state.ev_error = c.errors[0]
        state.ev_note = nil
        g8_view_state = state
        ui.board.render()
        return
    }
    state.ev_confirmed_event = c.event
    let m = ev_map(c.event)
    if !m.passed {
        state.ev_error = "这个事件暂时无法映射到计算引擎：" + m.reason
        state.ev_note = nil
        g8_view_state = state
        ui.board.render()
        return
    }
    state.ev_error = nil
    state.ev_note = m.note
    let validated = g6_validate(m.intent)
    flow_run_scenario_to_result(state, validated)
}

fn g8_on_click_ev_ai() {
    let state = g8_clone_state(g8_view_state)
    let probe = ev_ai_probe()
    if probe.available { state.ev_ai_status = "granted" }
    else { state.ev_ai_status = "unavailable" }
    state.ev_ai_message = probe.message
    g8_view_state = state
    ui.board.render()
}

fn g8_on_click_ev_ai_ingest() {
    let state = g8_clone_state(g8_view_state)
    let r = ev_from_ai_json(ui.entry.text())
    if !r.passed {
        state.ev_error = r.error
        g8_view_state = state
        ui.board.render()
        return
    }
    state.ev_draft = r.draft
    state.ev_error = nil
    state.ev_note = "已从 AI 返回的 JSON 生成草稿（未确认、没有计算）。请核对金额与月数，再点「确认并计算」。"
    ui.entry.set_text("")
    g8_view_state = state
    ui.board.render()
}

fn flow_submit_text(text) {
    let state = g8_clone_state(g8_view_state)
    state.input_text = text
    state.scenario_summary = nil
    state.simulation_result = nil
    state.policy_status_baseline = nil
    state.policy_status_scenario = nil
    state.last_scenario_id = nil
    state.last_scenario_cash_at_horizon = nil
    state.last_scenario_buffer_at_horizon = nil

    if state.household == nil {
        state.screen = G8_VALIDATION_FAILURE
        state.validation_error = { errors: ["no household loaded; run migration or set up household first"] }
        g8_view_state = state
        ui.board.render()
        return state
    }

    let parsed = g5_parse(text, state.household)

    if parsed.kind == "ParseFailure" {
        state.screen = G8_PARSE_FAILURE
        state.parse_status = "ParseFailure"
        state.clarification = nil
        state.validation_error = nil
        g8_view_state = state
        ui.board.render()
        return state
    }

    if parsed.kind == "ClarificationRequest" {
        state.screen = G8_NEED_CLARIFICATION
        state.parse_status = "ClarificationRequest"
        state.clarification = { missing_fields: parsed.missing_fields, question: parsed.question }
        state.validation_error = nil
        g8_view_state = state
        ui.board.render()
        return state
    }

    state.parse_status = "ParsedIntent"

    let validated = g6_validate(parsed)

    if validated.kind == "ValidationFailure" {
        state.screen = G8_VALIDATION_FAILURE
        state.validation_error = { errors: validated.errors }
        state.clarification = nil
        g8_view_state = state
        ui.board.render()
        return state
    }

    if validated.kind == "ClarificationRequest" {
        state.screen = G8_NEED_CLARIFICATION
        state.clarification = { missing_fields: validated.missing_fields, question: validated.question }
        state.validation_error = nil
        g8_view_state = state
        ui.board.render()
        return state
    }

    state.screen = G8_RESULT
    flow_run_scenario_to_result(state, validated)
    return state
}

fn flow_run_scenario_to_result(state, scenario) {
    if scenario.kind == "ValidationFailure" {
        state.screen = G8_VALIDATION_FAILURE
        state.validation_error = { errors: scenario.errors }
        state.clarification = nil
        g8_view_state = state
        ui.board.render()
        return state
    }
    if scenario.kind == "ClarificationRequest" {
        state.screen = G8_NEED_CLARIFICATION
        state.clarification = { missing_fields: scenario.missing_fields, question: scenario.question }
        state.validation_error = nil
        g8_view_state = state
        ui.board.render()
        return state
    }

    state.scenario_summary = {
        type: scenario.type,
        duration_months: scenario.duration_months,
        purchase_amount: scenario.purchase_amount,
        monthly_income_delta: scenario.monthly_income_delta,
        monthly_expense_delta: scenario.monthly_expense_delta
    }
    state.last_scenario_id = scenario.scenario_id

    let simulation = g3_simulate(state.household, scenario)

    if simulation.kind == "Error" {
        state.screen = G8_VALIDATION_FAILURE
        state.validation_error = { errors: [simulation.reason] }
        g8_view_state = state
        ui.board.render()
        return state
    }

    let policy = g4_policy_evaluate(simulation, g8_default_policy(state.household))

    state.simulation_result = policy
    state.policy_status_baseline = policy.baseline_path.policy_status
    state.policy_status_scenario = policy.scenario_path.policy_status
    state.last_scenario_cash_at_horizon = policy.scenario_path.cash_at_horizon
    state.last_scenario_buffer_at_horizon = policy.scenario_path.buffer_at_horizon

    state.screen = G8_RESULT
    g8_view_state = state
    ui.board.render()
    return state
}

// G8 call-contract helper. g7_now_str() returns local_time()'s object, not a
// string, so a record whose created_at came from it cannot be serialized to
// JSON. The G8 caller therefore passes a real ISO string itself.
fn g8_pad2(n) {
    if n == nil { return "00" }
    if n < 10 { return "0" + n.to_string() }
    return n.to_string()
}

fn g8_now_str() {
    let t = local_time()
    if t == nil { return "2026-10-05T00:00:00Z" }
    return t.year.to_string() + "-" + g8_pad2(t.month) + "-" + g8_pad2(t.day)
        + "T" + g8_pad2(t.hour) + ":" + g8_pad2(t.minute) + ":" + g8_pad2(t.second) + "Z"
}

// G8 persistence. fs.remove() traps in the pinned runtime, so the G1
// atomic-write helper aborts on its tmp-cleanup step — after the payload is
// already on disk. These write the same paths and the same JSON shape without
// that step, so G1's loaders still read what G8 wrote.
fn g8_write_json(path, json) {
    if json == nil { return { success: false, error: "to_json failed" } }
    fs.write(path, json)
    if !fs.exists(path) { return { success: false, error: "write failed" } }
    return { success: true, error: nil }
}

fn g8_save_decisions(records) {
    let payload = { schema_version: 1, decisions: records }
    return g8_write_json(PERSIST_DECISIONS_FILE, payload.to_json())
}

fn g8_save_household(h) {
    if !domain_is_household_state(h) {
        return { success: false, error: "not a HouseholdState" }
    }
    let payload = {
        schema_version: PERSIST_SCHEMA_VERSION,
        household_id: h.household_id,
        created_at: h.created_at,
        updated_at: persist_now_str(),
        monthly_income: h.monthly_income,
        mortgage: h.mortgage,
        living: h.living,
        liquid_cash: h.liquid_cash,
        safety_floor_months: h.safety_floor_months
    }
    return g8_write_json(PERSIST_FILE, payload.to_json())
}

fn flow_decide(choice) {
    let state = g8_clone_state(g8_view_state)

    let valid = ["accept", "decline", "defer"]
    let choice_ok = false
    for i in valid.len() {
        if choice == valid[i] { choice_ok = true }
    }
    if !choice_ok { return state }

    if state.last_scenario_id == nil { return state }
    if state.household == nil { return state }

    let nec = state.household.mortgage + state.household.living
    let current_cash = state.household.liquid_cash
    let current_buffer = current_cash / nec
    let snapshot = {
        cash: current_cash,
        buffer_months: current_buffer
    }

    let result = g7_record({
        cap: G7_DEFAULT_CAP,
        decision_id: nil,
        created_at: g8_now_str(),
        reason: nil,
        review_at: nil,
        legacy_migration: nil,
        scenario_id: state.last_scenario_id,
        user_choice: choice,
        snapshot: snapshot,
        policy_status: state.policy_status_scenario
    })

    if !result.success { return state }

    let all = g7_recent(g7_size())

    let save_decisions = g8_save_decisions(all)

    state.recent_decisions = all
    state.screen = G8_DECISION_RECORDED
    state.decision_count = g7_size()
    state.last_decision = result.record

    if state.household != nil {
        let save_household = g8_save_household(state.household)
        state.persistence_status = { success: save_decisions.success && save_household.success, error: save_household.error }
    }

    g8_view_state = state
    ui.board.render()
    return state
}

fn flow_set_screen(screen) {
    let state = g8_clone_state(g8_view_state)
    state.screen = screen
    if screen == G8_IDLE {
        state.scenario_summary = nil
        state.simulation_result = nil
        state.policy_status_baseline = nil
        state.policy_status_scenario = nil
        state.last_scenario_id = nil
        state.last_scenario_cash_at_horizon = nil
        state.last_scenario_buffer_at_horizon = nil
    }
    g8_view_state = state
    ui.board.render()
}

fn g8_init() {
    let dec_loaded = persist_load_decisions()
    if dec_loaded.kind == "Records" {
        g7_set_all(dec_loaded.records)
    }
    let loaded = persist_load_household()
    if loaded.kind == "HouseholdState" {
        let state = g8_clone_state(g8_view_state)
        state.household = loaded
        state.recent_decisions = g7_recent(g7_size())
        state.decision_count = g7_size()
        state.screen = G8_IDLE
        g8_view_state = state
        ui.board.render()
        return state
    }
    if loaded.kind == "NeedsMigration" {
        let mig = persist_migrate_v01_to_v02()
        if mig.success {
            let state = g8_clone_state(g8_view_state)
            state.household = mig.state
            state.migration_notice = { notices: mig.notices }
            state.screen = G8_IDLE
            g8_view_state = state
            ui.board.render()
            return state
        }
    }
    let state = g8_clone_state(g8_view_state)
    state.screen = G8_IDLE
    g8_view_state = state
    ui.board.render()
    return state
}

fn g8_on_submit_text() {
    let text = ui.entry.text().trim()
    if text == "" { return }
    ui.entry.set_text("")
    flow_submit_text(text)
}

fn g8_on_click_now() {
    flow_set_screen(G8_IDLE)
}

fn g8_on_click_calc() {
    flow_set_screen(G8_CALC)
}

// FLOW is a read-only monthly breakdown. Entering it never clears the
// simulation result; only g8_on_click_now() / flow_set_screen(G8_IDLE) do.
fn g8_on_click_flow() {
    let state = g8_clone_state(g8_view_state)
    state.screen = G8_FLOW
    let smi = 1
    if state.simulation_result != nil {
        let b9 = try { state.simulation_result.scenario_path.breach_month } { nil }
        if b9 != nil { smi = b9 }
    }
    state.selected_month = smi
    g8_view_state = state
    ui.board.render()
}

// Back to RESULT keeping the existing simulation_result untouched.
fn g8_on_click_back_result() {
    let state = g8_clone_state(g8_view_state)
    state.screen = G8_RESULT
    g8_view_state = state
    ui.board.render()
}

// ----- First-run onboarding (G8 only; reuses domain_HouseholdState) -----

fn g8_onboard_step_def(n) {
    if n == 0 { return { key: "monthly_income", label: "月收入", hint: "全家每月税后收入（元）", def: nil, min: 0 } }
    if n == 1 { return { key: "mortgage", label: "房贷", hint: "每月房贷还款（元）", def: nil, min: 0 } }
    if n == 2 { return { key: "living", label: "必要生活支出", hint: "吃饭、交通、学费等每月必要开销（元）", def: nil, min: 1 } }
    if n == 3 { return { key: "liquid_cash", label: "可用现金", hint: "存款等随时能动用的钱（元）", def: nil, min: 0 } }
    return { key: "safety_floor_months", label: "安全垫月数", hint: "希望至少能撑几个月（默认 12）", def: 12, min: 1 }
}

fn g8_onboard_prefill(step) {
    let def = g8_onboard_step_def(step)
    if def.def != nil {
        ui.entry.set_text("" + def.def)
    } else {
        ui.entry.set_text("")
    }
}

fn g8_on_click_onboard_start() {
    let state = g8_clone_state(g8_view_state)
    state.screen = G8_ONBOARD
    state.onboard_step = 0
    state.onboard_data = {}
    state.onboard_error = nil
    g8_view_state = state
    g8_onboard_prefill(0)
    ui.board.render()
}

fn g8_on_click_onboard_demo() {
    let state = g8_clone_state(g8_view_state)
    state.household = g3_demo_household()
    state.household_is_demo = true
    state.screen = G8_IDLE
    g8_view_state = state
    ui.board.render()
}

fn g8_on_click_onboard_back() {
    let state = g8_clone_state(g8_view_state)
    let step = state.onboard_step
    if step == nil { return }
    if step == 0 {
        state.onboard_step = nil
        state.onboard_error = nil
        g8_view_state = state
        ui.board.render()
        return
    }
    state.onboard_step = step - 1
    state.onboard_error = nil
    g8_view_state = state
    g8_onboard_prefill(state.onboard_step)
    ui.board.render()
}

fn g8_on_click_onboard_next() {
    let state = g8_clone_state(g8_view_state)
    let step = state.onboard_step
    if step == nil { return }
    let def = g8_onboard_step_def(step)
    let raw = ui.entry.text().trim()
    let v = nil
    if raw == "" && def.def != nil {
        v = def.def
    }
    if raw == "" && def.def == nil {
        state.onboard_error = def.label + "需要一个数字，比如 40000"
        g8_view_state = state
        ui.board.render()
        return
    }
    if raw != "" {
        let parsed = raw.to_f64()
        if parsed != parsed {
            state.onboard_error = "没看懂这个数字，请只填数字（元）"
            g8_view_state = state
            ui.board.render()
            return
        }
        if parsed < def.min {
            state.onboard_error = def.label + "不能小于 " + def.min
            g8_view_state = state
            ui.board.render()
            return
        }
        v = parsed
    }
    if def.key == "monthly_income" { state.onboard_data.monthly_income = v }
    if def.key == "mortgage" { state.onboard_data.mortgage = v }
    if def.key == "living" { state.onboard_data.living = v }
    if def.key == "liquid_cash" { state.onboard_data.liquid_cash = v }
    if def.key == "safety_floor_months" { state.onboard_data.safety_floor_months = v }
    state.onboard_error = nil
    if step >= 4 {
        let h = domain_HouseholdState({
            schema_version: 2,
            household_id: "h_main",
            created_at: g8_now_str(),
            updated_at: g8_now_str(),
            monthly_income: state.onboard_data.monthly_income,
            mortgage: state.onboard_data.mortgage,
            living: state.onboard_data.living,
            liquid_cash: state.onboard_data.liquid_cash,
            safety_floor_months: state.onboard_data.safety_floor_months
        })
        if h.kind == "ValidationError" {
            state.onboard_error = "数字好像有问题：" + h.errors[0]
            g8_view_state = state
            ui.board.render()
            return
        }
        state.household = h
        state.household_is_demo = false
        state.screen = G8_IDLE
        state.onboard_step = nil
        state.persistence_status = g8_save_household(h)
        ui.entry.set_text("")
        g8_view_state = state
        ui.board.render()
        return
    }
    state.onboard_step = step + 1
    g8_view_state = state
    g8_onboard_prefill(state.onboard_step)
    ui.board.render()
}

fn g8_on_click_scenario_preset(text) {
    flow_submit_text(text)
}

fn g8_on_click_scenario_rest(months) {
    let state = g8_clone_state(g8_view_state)
    state.input_text = "休息 " + months.to_string() + " 个月"
    state.scenario_summary = nil
    state.simulation_result = nil
    state.policy_status_baseline = nil
    state.policy_status_scenario = nil
    state.last_scenario_id = nil
    state.last_scenario_cash_at_horizon = nil
    state.last_scenario_buffer_at_horizon = nil

    if state.household == nil {
        state.screen = G8_VALIDATION_FAILURE
        state.validation_error = { errors: ["no household loaded"] }
        g8_view_state = state
        ui.board.render()
        return state
    }

    let scenario = domain_Scenario({
        scenario_id: "sc_rest",
        type: "REST",
        start_month: 0,
        duration_months: months,
        created_at: persist_now_str(),
        description: nil,
        purchase_amount: nil,
        monthly_income_delta: nil,
        monthly_expense_delta: nil
    })
    flow_run_scenario_to_result(state, scenario)
    return state
}

fn g8_on_click_decide(choice) {
    flow_decide(choice)
}

fn g8_render_text() {
    let state = g8_view_state
    if state.household == nil {
        return "请先在终端运行迁移或输入家庭信息"
    }
    if state.screen == G8_IDLE {
        let nec = state.household.mortgage + state.household.living
        let buf = state.household.liquid_cash / nec
        return "现在缓冲 " + fmt_num(buf) + " 个月。安全线 " + fmt_num(state.household.safety_floor_months) + " 个月。"
    }
    if state.screen == G8_PARSE_FAILURE { return "我没听懂。" }
    if state.screen == G8_NEED_CLARIFICATION {
        if state.clarification != nil { return state.clarification.question }
    }
    if state.screen == G8_VALIDATION_FAILURE {
        return "输入有误"
    }
    if state.screen == G8_CALC {
        let nec = state.household.mortgage + state.household.living
        let buf = state.household.liquid_cash / nec
        let line = "复算：必要支出 " + fmt_yuan(nec) + " 元/月，余量 " + fmt_num(buf) + " 个月 = 现金 ÷ 必要支出"
        if state.simulation_result != nil {
            line = line + "；事件后 " + fmt_num(state.simulation_result.scenario_path.buffer_at_horizon) + " 个月"
        }
        return line
    }
    if state.screen == G8_FLOW {
        if state.simulation_result == nil { return "还没有可展示的逐月推演" }
        return "逐月现金流对照"
    }
    if state.screen == G8_ONBOARD {
        return "建立家庭情况"
    }
    if state.screen == G8_RESULT {
        if state.simulation_result != nil {
            return state.scenario_summary.type + " 后缓冲 " + fmt_num(state.simulation_result.scenario_path.buffer_at_horizon) + " 个月（" + state.policy_status_scenario + "）"
        }
    }
    if state.screen == G8_DECISION_RECORDED {
        return "已记录决定"
    }
    return ""
}

