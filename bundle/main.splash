// =====================================================================
// G1 — Persistence + Migration (Final Patch, frozen)
// Persists HouseholdState to household.json. Migrates v0.1 state.json →
// v0.2 household.json. Atomic write: best-effort given fs.* has no rename
// (write-tmp then overwrite-target then remove-tmp). No simulation/policy/
// parser/flow/render/UI logic. Migration only reports single_income as a
// notice; never guesses.
// =====================================================================

let PERSIST_FILE = "household.json"
let PERSIST_TMP = "household.json.tmp"
let PERSIST_LEGACY = "state.json"
let PERSIST_DECISIONS_FILE = "decisions.json"
let PERSIST_SCHEMA_VERSION = 2

// `local_time()` is NOT a string: the runtime builds a struct
// {year month day hour minute second weekday} (makepad/platform/src/script/
// timer.rs, `std.local_time`). Calling to_string() on that struct is the
// literal "[ScriptObject]", which is what this used to persist as
// `updated_at`. Format the fields instead, exactly the way g8_now_str()
// already writes `created_at`. `time_now()` (epoch seconds) stays as the
// fallback, so a missing clock still yields a real number rather than a
// fabricated date and no API is guessed.
fn persist_now_str() {
    let t = local_time()
    if t != nil {
        let mo = t.month.to_string()
        let dy = t.day.to_string()
        let hh = t.hour.to_string()
        let mi = t.minute.to_string()
        let ss = t.second.to_string()
        if t.month < 10 { mo = "0" + mo }
        if t.day < 10 { dy = "0" + dy }
        if t.hour < 10 { hh = "0" + hh }
        if t.minute < 10 { mi = "0" + mi }
        if t.second < 10 { ss = "0" + ss }
        return t.year.to_string() + "-" + mo + "-" + dy + "T" + hh + ":" + mi + ":" + ss + "Z"
    }
    let n = time_now()
    if n == nil { return "1970-01-01T00:00:00Z" }
    return n.to_string()
}

fn persist_generate_id() {
    let n = time_now()
    if n == nil { return "h_unknown" }
    return "h_" + n.to_string()
}

fn persist_atomic_write(path, content) {
    let tmp = path + ".tmp"
    fs.write(tmp, content)
    if !fs.exists(tmp) {
        return { success: false, error: "tmp write failed" }
    }
    fs.write(path, content)
    if !fs.exists(path) {
        return { success: false, error: "main write failed; tmp preserved" }
    }
    fs.remove(tmp)
    return { success: true }
}

fn persist_save_household(state) {
    if !domain_is_household_state(state) {
        return { success: false, error: "not a HouseholdState" }
    }
    let payload = {
        schema_version: PERSIST_SCHEMA_VERSION,
        household_id: state.household_id,
        created_at: state.created_at,
        updated_at: persist_now_str(),
        monthly_income: state.monthly_income,
        mortgage: state.mortgage,
        living: state.living,
        liquid_cash: state.liquid_cash,
        safety_floor_months: state.safety_floor_months
    }
    let json = payload.to_json()
    return persist_atomic_write(PERSIST_FILE, json)
}

fn persist_load_household() {
    if fs.exists(PERSIST_FILE) {
        let text = fs.read(PERSIST_FILE)
        let parsed = text.parse_json()
        if parsed == nil {
            return { kind: "Corrupt", error: "parse_json returned nil" }
        }
        if parsed.schema_version != PERSIST_SCHEMA_VERSION {
            let msg = "schema_version mismatch: expected "
            msg = msg + PERSIST_SCHEMA_VERSION.to_string()
            msg = msg + ", got "
            if parsed.schema_version == nil { msg = msg + "nil" }
            else { msg = msg + parsed.schema_version.to_string() }
            return { kind: "Corrupt", error: msg }
        }
        let validated = domain_HouseholdState({
            schema_version: parsed.schema_version,
            household_id: parsed.household_id,
            created_at: parsed.created_at,
            updated_at: parsed.updated_at,
            monthly_income: parsed.monthly_income,
            mortgage: parsed.mortgage,
            living: parsed.living,
            liquid_cash: parsed.liquid_cash,
            safety_floor_months: parsed.safety_floor_months
        })
        if validated.kind == "ValidationError" {
            return { kind: "Corrupt", errors: validated.errors }
        }
        return validated
    }
    if fs.exists(PERSIST_LEGACY) {
        return { kind: "NeedsMigration", source: PERSIST_LEGACY }
    }
    return { kind: "Empty" }
}

fn persist_migrate_v01_to_v02() {
    if !fs.exists(PERSIST_LEGACY) {
        return { success: false, errors: ["no legacy state.json"] }
    }
    let text = fs.read(PERSIST_LEGACY)
    let v = text.parse_json()
    if v == nil {
        return { success: false, errors: ["legacy state.json parse failed"] }
    }
    let notices = []
    if v.single_income == true {
        notices.push("v0.1 had single_income=true; no equivalent field in v0.2")
    }
    let now = persist_now_str()
    let args = {
        schema_version: PERSIST_SCHEMA_VERSION,
        household_id: persist_generate_id(),
        created_at: now,
        updated_at: now,
        monthly_income: v.income,
        mortgage: v.mortgage,
        living: v.living,
        liquid_cash: v.savings,
        safety_floor_months: v.safety
    }
    let validated = domain_HouseholdState(args)
    if validated.kind == "ValidationError" {
        return { success: false, errors: validated.errors, notices: notices }
    }
    let save_result = persist_save_household(validated)
    if !save_result.success {
        let errs = ["save failed: " + save_result.error]
        return { success: false, errors: errs, notices: notices }
    }
    return { success: true, state: validated, notices: notices }
}

fn persist_save_decisions(records) {
    let payload = { schema_version: 1, decisions: records }
    let json = payload.to_json()
    return persist_atomic_write(PERSIST_DECISIONS_FILE, json)
}

fn persist_load_decisions() {
    if !fs.exists(PERSIST_DECISIONS_FILE) { return { kind: "Empty" } }
    let text = fs.read(PERSIST_DECISIONS_FILE)
    let parsed = text.parse_json()
    if parsed == nil { return { kind: "Corrupt" } }
    if parsed.decisions == nil { return { kind: "Empty" } }
    let valid = []
    let decisions = parsed.decisions
    for i in decisions.len() {
        let r = domain_DecisionRecord(decisions[i])
        if r.kind == "DecisionRecord" { valid.push(r) }
    }
    return { kind: "Records", records: valid }
}

fn g1_test_roundtrip() {
    let original = domain_HouseholdState({
        schema_version: 2,
        household_id: "h_test_roundtrip",
        created_at: "2026-10-05T00:00:00Z",
        updated_at: "2026-10-05T00:00:00Z",
        monthly_income: 40000,
        mortgage: 15000,
        living: 12000,
        liquid_cash: 800000,
        safety_floor_months: 12
    })
    if original.kind == "ValidationError" {
        return { success: false, error: "construction failed", errors: original.errors }
    }
    let save_result = persist_save_household(original)
    if !save_result.success {
        return { success: false, error: "save failed: " + save_result.error }
    }
    let loaded = persist_load_household()
    if loaded.kind != "HouseholdState" {
        return { success: false, error: "load returned kind=" + loaded.kind }
    }
    if loaded.monthly_income != original.monthly_income {
        return { success: false, error: "monthly_income mismatch" }
    }
    if loaded.liquid_cash != original.liquid_cash {
        return { success: false, error: "liquid_cash mismatch" }
    }
    if loaded.safety_floor_months != original.safety_floor_months {
        return { success: false, error: "safety_floor_months mismatch" }
    }
    if loaded.mortgage != original.mortgage {
        return { success: false, error: "mortgage mismatch" }
    }
    if loaded.living != original.living {
        return { success: false, error: "living mismatch" }
    }
    return { success: true }
}

fn g1_test_migration() {
    let result = persist_migrate_v01_to_v02()
    if !result.success {
        return { success: false, error: "migration failed", errors: result.errors }
    }
    if result.state == nil {
        return { success: false, error: "migration returned nil state" }
    }
    if result.state.kind != "HouseholdState" {
        return { success: false, error: "migration state kind wrong" }
    }
    let loaded = persist_load_household()
    if loaded.kind != "HouseholdState" {
        return { success: false, error: "after migration, load kind=" + loaded.kind }
    }
    return { success: true, notices: result.notices }
}

// =====================================================================
// End of G1
