    if s.monthly_income_delta != -5000 { return { ok: false, error: "delta wrong" } }
    if s.monthly_expense_delta != nil { return { ok: false, error: "expense delta should be nil" } }
    return { ok: true }
}

fn g2_test_income_change_with_expense_delta_forbidden() {
    let s = g2_INCOME_CHANGE({
        scenario_id: "sc_inc_bad",
        monthly_income_delta: -5000,
        monthly_expense_delta: 100,
        created_at: "2026-10-05T00:00:00Z"
    })
    if s.kind != "ValidationError" { return { ok: false, error: "INCOME_CHANGE w/ expense delta should fail" } }
    return { ok: true }
}

fn g2_test_expense_change_ok() {
    let s = g2_EXPENSE_CHANGE({
        scenario_id: "sc_exp_ok",
        monthly_expense_delta: 3000,
        duration_months: 0,
        created_at: "2026-10-05T00:00:00Z"
    })
    if s.kind != "Scenario" { return { ok: false, error: "EXPENSE_CHANGE ok failed", got: s } }
    if s.type != "EXPENSE_CHANGE" { return { ok: false, error: "type wrong" } }
    if s.monthly_expense_delta != 3000 { return { ok: false, error: "delta wrong" } }
    return { ok: true }
}

