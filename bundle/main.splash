fn g3_test_trace_baseline_net_change() {
    let h = g3_demo_household()
    let s = g2_REST({
        scenario_id: "s",
        start_month: 0,
        duration_months: 6,
        created_at: "t",
        description: nil
    })
    let r = g3_simulate(h, s)
    if r.kind != "SimulationResult" { return { success: false, error: "simulate failed" } }
    if r.trace.len() != 7 { return { success: false, error: "trace length should be horizon + 1", got: r.trace.len() } }
    if r.trace[1].baseline.net_change != 13000 { return { success: false, error: "baseline net_change should be 13000", got: r.trace[1].baseline.net_change } }
    if r.trace[1].baseline.ending_cash != 813000 { return { success: false, error: "baseline ending_cash should be 813000", got: r.trace[1].baseline.ending_cash } }
    for i in r.trace.len() {
        if i > 0 {
            if r.trace[i].baseline.net_change != 13000 { return { success: false, error: "every baseline month should net 13000", got: r.trace[i].baseline.net_change } }
        }
    }
    return { success: true }
}

