    if s.type != "CAR_PURCHASE" { return { ok: false, error: "type wrong" } }
    if s.purchase_amount != 300000 { return { ok: false, error: "purchase_amount wrong" } }
    if s.duration_months != 0 { return { ok: false, error: "default duration wrong" } }
    return { ok: true }
}

