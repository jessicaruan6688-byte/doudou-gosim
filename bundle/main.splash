// =====================================================================
// End of G5
// =====================================================================

// =====================================================================
// G6 — Validation (Final Patch, frozen)
// Pure validate(ParsedIntent) -> Scenario | ClarificationRequest |
// ValidationFailure. Only layer allowed to convert ParsedIntent to
// typed Scenario (routes through G2, never bypasses).
// Missing required field → ClarificationRequest.
// Field shape / range / enum violation → ValidationFailure.
// Dangerous-but-valid scenarios (purchase > cash, long drain, expense
// > income) are NOT rejected here — those flow to G3/G4.
// =====================================================================

fn g6_intent_in_enum(intent_type) {
    let valid = ["REST", "CAR_PURCHASE", "INCOME_CHANGE", "EXPENSE_CHANGE"]
    for i in valid.len() {
        if intent_type == valid[i] { return true }
    }
    return false
}

fn g6_validate_field_shape(intent) {
    let errs = []
    if intent.intent_type == nil {
        errs.push("intent_type missing")
    }
    if intent.intent_type != nil && !g6_intent_in_enum(intent.intent_type) {
        errs.push("intent_type not in enum: " + intent.intent_type)
    }
    if intent.start_month != nil && intent.start_month < 0 {
        errs.push("start_month negative")
    }
    if intent.duration_months != nil && intent.duration_months < 0 {
        errs.push("duration_months negative")
    }
    if intent.intent_type == "REST" {
        if intent.duration_months != nil && intent.duration_months == 0 {
            errs.push("REST duration_months must be > 0")
        }
    }
    if intent.intent_type == "CAR_PURCHASE" {
        if intent.purchase_amount != nil && intent.purchase_amount < 0 {
            errs.push("purchase_amount negative")
        }
    }
    if errs.len() > 0 {
        return { kind: "ValidationFailure", errors: errs }
    }
    return { kind: "Ok" }
}

fn g6_validate_required_fields(intent) {
    let missing = []
    if intent.intent_type == "REST" {
        if intent.duration_months == nil { missing.push("duration_months") }
    }
    if intent.intent_type == "CAR_PURCHASE" {
        if intent.purchase_amount == nil { missing.push("purchase_amount") }
    }
    if intent.intent_type == "INCOME_CHANGE" {
        if intent.monthly_income_delta == nil { missing.push("monthly_income_delta") }
    }
    if intent.intent_type == "EXPENSE_CHANGE" {
        if intent.monthly_expense_delta == nil { missing.push("monthly_expense_delta") }
    }
    if missing.len() > 0 {
        return { kind: "Clarification", missing: missing }
    }
    return { kind: "Ok" }
}

fn g6_question_for_missing(intent_type) {
    if intent_type == "REST" { return "你想休息几个月？" }
    if intent_type == "CAR_PURCHASE" { return "这辆车大概多少钱？" }
    if intent_type == "INCOME_CHANGE" { return "收入变化多少？" }
    if intent_type == "EXPENSE_CHANGE" { return "支出变化多少？" }
    return "请补充信息"
}

fn g6_now_str() {
    let t = local_time()
    if t == nil || t == "" { return "2026-10-05T00:00:00Z" }
    return t
}

fn g6_validate(intent) {
    if intent == nil || intent.kind != "ParsedIntent" {
        return domain_ValidationFailure(["not a ParsedIntent"])
    }

    let shape = g6_validate_field_shape(intent)
    if shape.kind == "ValidationFailure" {
        return domain_ValidationFailure(shape.errors)
    }

    let required = g6_validate_required_fields(intent)
    if required.kind == "Clarification" {
        return domain_ClarificationRequest({
            missing_fields: required.missing,
            question: g6_question_for_missing(intent.intent_type)
        })
    }

    let now = g6_now_str()
    let start_month = intent.start_month
    if start_month == nil { start_month = 0 }

    let scenario = nil
    if intent.intent_type == "REST" {
        scenario = g2_REST({
            scenario_id: "sc_rest",
            start_month: start_month,
            duration_months: intent.duration_months,
            created_at: now
        })
    }
    if intent.intent_type == "CAR_PURCHASE" {
        scenario = g2_CAR_PURCHASE({
            scenario_id: "sc_car",
            start_month: start_month,
            purchase_amount: intent.purchase_amount,
            created_at: now
        })
    }
    if intent.intent_type == "INCOME_CHANGE" {
        scenario = g2_INCOME_CHANGE({
            scenario_id: "sc_inc",
            start_month: start_month,
            duration_months: intent.duration_months,
            monthly_income_delta: intent.monthly_income_delta,
            created_at: now
        })
    }
    if intent.intent_type == "EXPENSE_CHANGE" {
        scenario = g2_EXPENSE_CHANGE({
            scenario_id: "sc_exp",
            start_month: start_month,
            duration_months: intent.duration_months,
            monthly_expense_delta: intent.monthly_expense_delta,
            created_at: now
        })
    }

    if scenario == nil {
        return domain_ValidationFailure(["scenario construction returned nil"])
    }
    if scenario.kind == "ValidationError" {
        return domain_ValidationFailure(scenario.errors)
    }
    return scenario
}

fn g6_make_intent(type, duration, start_month, amount, income_delta, expense_delta) {
    return domain_ParsedIntent({
        intent_type: type,
        start_month: start_month,
        duration_months: duration,
        purchase_amount: amount,
        monthly_income_delta: income_delta,
        monthly_expense_delta: expense_delta,
        ambiguous_fields: []
    })
}

