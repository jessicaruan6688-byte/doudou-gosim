    let tagged = g4_policy_evaluate(r, policy)
    if r.baseline_path.policy_status != original_status {
        return { success: false, error: "policy_evaluate mutated input" }
    }
    if tagged.baseline_path.policy_status != "warn" {
        return { success: false, error: "tagged should be warn" }
    }
    return { success: true }
}

// =====================================================================
// End of G4
// =====================================================================

// =====================================================================
// G5 — Agent Parsing (Final Patch, frozen)
// Pure text → ParsedIntent | ClarificationRequest | ParseFailure.
// No validation, no Scenario construction, no math, no HouseholdState
// mutation, no persistence. Missing fields → ClarificationRequest.
// Cannot understand at all → ParseFailure. Never guesses values.
// =====================================================================

fn g5_has_any(text, keywords) {
    for i in keywords.len() {
        if text.search(keywords[i]) >= 0 { return true }
    }
    return false
}

fn g5_extract_wan_amount(text) {
    let found = regex("(\\d+(?:\\.\\d+)?)\\s*万", "").exec(text)
    if found == nil { return nil }
    return found.captures[1].to_f64() * 10000.0
}

fn g5_extract_months(text) {
    return months_near(text)
}

fn g5_intent_type_match(text) {
    let rest_kw = ["辞职", "休息", "不干了", "career break", "careerbreak"]
    let car_kw = ["买车", "购车", "买辆", "购入"]
    let inc_kw = ["涨薪", "加薪", "降薪", "扣钱", "工资变", "工资涨", "工资降"]
    let exp_kw = ["多花", "少花", "开销", "支出变", "支出涨", "支出降"]

    let rest_m = g5_has_any(text, rest_kw)
    let car_m = g5_has_any(text, car_kw)
    let inc_m = g5_has_any(text, inc_kw)
    let exp_m = g5_has_any(text, exp_kw)

    let count = 0
    let intent = nil
    if rest_m { count = count + 1; intent = "REST" }
    if car_m { count = count + 1; if intent == nil { intent = "CAR_PURCHASE" } }
    if inc_m { count = count + 1; if intent == nil { intent = "INCOME_CHANGE" } }
    if exp_m { count = count + 1; if intent == nil { intent = "EXPENSE_CHANGE" } }

    if count == 0 { return { kind: "None" } }
    if count > 1 { return { kind: "Ambiguous" } }
    return { kind: "Single", intent: intent }
}

fn g5_signed_amount(text, positive_kws, negative_kws) {
    let amount = g5_extract_wan_amount(text)
    if amount == nil { return { success: false, reason: "no_amount" } }
    let pos = g5_has_any(text, positive_kws)
    let neg = g5_has_any(text, negative_kws)
    if pos && neg { return { success: false, reason: "ambiguous_sign" } }
    if !pos && !neg { return { success: false, reason: "no_sign_keyword" } }
    let sign = 1
    if neg { sign = 0 - 1 }
    return { success: true, amount: sign * amount }
}

fn g5_extract_rest(text) {
    let duration = g5_extract_months(text)
    if duration == nil {
        return domain_ClarificationRequest({
            missing_fields: ["duration_months"],
            question: "你想休息几个月？"
        })
    }
    return domain_ParsedIntent({
        intent_type: "REST",
        start_month: nil,
        duration_months: duration,
        purchase_amount: nil,
        monthly_income_delta: nil,
        monthly_expense_delta: nil,
        ambiguous_fields: []
    })
}

fn g5_extract_car(text) {
    let amount = g5_extract_wan_amount(text)
    if amount == nil {
        return domain_ClarificationRequest({
            missing_fields: ["purchase_amount"],
            question: "这辆车大概多少钱？"
        })
    }
    return domain_ParsedIntent({
        intent_type: "CAR_PURCHASE",
        start_month: nil,
        duration_months: 0,
        purchase_amount: amount,
        monthly_income_delta: nil,
        monthly_expense_delta: nil,
        ambiguous_fields: []
    })
}

fn g5_extract_income_change(text) {
    let pos_kw = ["涨", "加", "加薪", "涨薪", "上调"]
    let neg_kw = ["降", "减", "降薪", "减少", "扣"]
    let signed = g5_signed_amount(text, pos_kw, neg_kw)
    if !signed.success {
        if signed.reason == "ambiguous_sign" {
            return domain_ClarificationRequest({
                missing_fields: ["monthly_income_delta"],
                question: "收入变化方向不明确：是涨还是降？"
            })
        }
        if signed.reason == "no_sign_keyword" {
            return domain_ClarificationRequest({
                missing_fields: ["monthly_income_delta"],
                question: "收入是涨还是降？涨/降多少？"
            })
        }
        return domain_ClarificationRequest({
            missing_fields: ["monthly_income_delta"],
            question: "收入变化多少？"
        })
    }
    let duration = g5_extract_months(text)
    return domain_ParsedIntent({
        intent_type: "INCOME_CHANGE",
        start_month: nil,
        duration_months: duration,
        purchase_amount: nil,
        monthly_income_delta: signed.amount,
        monthly_expense_delta: nil,
        ambiguous_fields: []
    })
}

fn g5_extract_expense_change(text) {
    let pos_kw = ["多花", "开销涨", "支出涨", "增加"]
    let neg_kw = ["少花", "开销降", "支出降", "减少"]
    let signed = g5_signed_amount(text, pos_kw, neg_kw)
    if !signed.success {
        if signed.reason == "ambiguous_sign" {
            return domain_ClarificationRequest({
                missing_fields: ["monthly_expense_delta"],
                question: "支出变化方向不明确：是多花还是少花？"
            })
        }
        if signed.reason == "no_sign_keyword" {
            return domain_ClarificationRequest({
                missing_fields: ["monthly_expense_delta"],
                question: "支出是多花还是少花？多少？"
            })
        }
        return domain_ClarificationRequest({
            missing_fields: ["monthly_expense_delta"],
            question: "支出变化多少？"
        })
    }
    let duration = g5_extract_months(text)
    return domain_ParsedIntent({
        intent_type: "EXPENSE_CHANGE",
        start_month: nil,
        duration_months: duration,
        purchase_amount: nil,
        monthly_income_delta: nil,
        monthly_expense_delta: signed.amount,
        ambiguous_fields: []
    })
}

fn g5_parse(text, household) {
    if text == nil || text == "" {
        return domain_ParseFailure("empty input")
    }
    let detection = g5_intent_type_match(text)
    if detection.kind == "None" {
        return domain_ParseFailure("no intent keyword recognized")
    }
    if detection.kind == "Ambiguous" {
        return domain_ClarificationRequest({
            missing_fields: ["intent_type"],
            question: "我没听懂，你想做什么？"
        })
    }
    let intent = detection.intent
    if intent == "REST" { return g5_extract_rest(text) }
    if intent == "CAR_PURCHASE" { return g5_extract_car(text) }
    if intent == "INCOME_CHANGE" { return g5_extract_income_change(text) }
    if intent == "EXPENSE_CHANGE" { return g5_extract_expense_change(text) }
    return domain_ParseFailure("unknown intent: " + intent)
}

