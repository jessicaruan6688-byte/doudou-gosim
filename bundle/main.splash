    let before_screen = g8_view_state.screen
    let r = g8_render_text()
    if g8_view_state.input_text != before_text { return { ok: false, error: "render mutated input_text" } }
    if g8_view_state.screen != before_screen { return { ok: false, error: "render mutated screen" } }
    return { ok: true }
}

